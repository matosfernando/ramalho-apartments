---
import Layout from '../layouts/Layout.astro';

const title = "FAQ – Ramalho Apartments";
const description = "Frequently asked questions about booking, amenities, check-in, and your stay in Ponta Delgada.";

const faqs = [
  { q: "How far is the airport?",            a: "João Paulo II Airport is 2 km from our apartments — about 5–10 minutes by taxi or ride-share. We can arrange airport transfers on request." },
  { q: "What are the check-in / check-out times?", a: "Standard check-in is 3 PM and check-out is 11 AM. Need flexibility? Let us know when you book and we'll do our best. Late arrivals are always welcome." },
  { q: "Is parking available?",              a: "Yes. Each property has designated parking or nearby street parking. Share your vehicle details when booking and we'll send instructions." },
  { q: "What amenities are included?",       a: "All apartments include WiFi, air conditioning, a full kitchen, smart TV, washing machine, hairdryer, and daily essentials. Check each property page for specifics." },
  { q: "What is the cancellation policy?",   a: "Full refund for cancellations 14+ days before arrival. 50% refund 7–13 days before. Non-refundable within 7 days. Contact us to discuss specific situations." },
  { q: "Do you offer long-stay discounts?",  a: "Yes — weekly and monthly rates are available. Contact us directly for a custom quote." },
  { q: "Is WiFi included?",                  a: "Yes, high-speed WiFi is included at no extra cost at all properties." },
  { q: "Are pets allowed?",                  a: "Generally yes — contact us before booking to discuss your pet. Some additional fees may apply." },
  { q: "What if there's an emergency?",      a: "We're available 24/7 via WhatsApp and phone. Emergency services in Portugal: call 112. Check-in info includes the nearest hospital location." },
  { q: "How do I get local recommendations?", a: "Every booking includes our comprehensive local guide. Our team is also happy to give personalised tips via WhatsApp." },
  { q: "Is there a minimum stay?",           a: "Classic City Stay: 3 nights. Modern Urban Living & Family Duplex: 2 nights. Contact us for shorter stays." },
  { q: "How do I book?",                     a: "Contact us via WhatsApp, email, or phone. WhatsApp is fastest. Tell us your dates and preferred property and we'll confirm availability instantly." },
];
---

<Layout {title} {description}>

  <!-- Page header -->
  <section style="background: var(--clr-bg-subtle); border-bottom: 1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block: 3rem 2.5rem;">
      <h1 style="margin-bottom:0.5rem;">Frequently asked questions</h1>
      <p style="font-size:1rem; max-width:480px;">
        Everything you need to know about staying with us. Can't find what you're looking for?
        <a href="https://wa.me/351918881000" target="_blank" rel="noopener noreferrer" style="color:var(--clr-text); font-weight:600; text-decoration:underline; text-underline-offset:3px;">
          Message us on WhatsApp.
        </a>
      </p>
    </div>
  </section>

  <!-- Accordion -->
  <section>
    <div class="page-wrap" style="padding-block: 2.5rem; max-width: 720px;">
      <div class="accordion" id="faq-accordion">
        {faqs.map((faq, i) => (
          <div class="accordion-item" id={`faq-item-${i}`}>
            <button
              class="accordion-btn"
              aria-expanded="false"
              aria-controls={`faq-body-${i}`}
              id={`faq-btn-${i}`}
            >
              <span>{faq.q}</span>
              <svg class="accordion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
              </svg>
            </button>
            <div
              class="accordion-body"
              id={`faq-body-${i}`}
              role="region"
              aria-labelledby={`faq-btn-${i}`}
            >
              {faq.a}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Still have questions -->
  <section style="background: var(--clr-bg-subtle); border-top: 1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block: 3rem; text-align:center; max-width: 560px;">
      <h2 style="margin-bottom:0.75rem; font-size:1.4rem;">Still have questions?</h2>
      <p style="margin-bottom:1.75rem; line-height:1.7;">
        Our team is happy to help. Reach out and we'll get back to you quickly.
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:center;">
        <a
          href="https://wa.me/351918881000?text=Hi! I have a question about your apartments."
          target="_blank" rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
          </svg>
          WhatsApp us
        </a>
        <a href="mailto:hello@ramalho.pt" class="btn btn-outline">
          Email us
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
document.querySelectorAll('.accordion-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const item   = btn.closest('.accordion-item') as HTMLElement;
    const isOpen = item.classList.contains('open');

    // Close all
    document.querySelectorAll('.accordion-item.open').forEach(el => {
      el.classList.remove('open');
      (el.querySelector('.accordion-btn') as HTMLElement)?.setAttribute('aria-expanded', 'false');
    });

    // Toggle clicked
    if (!isOpen) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  });
});
</script>
