---
import PropertyLayout from '../layouts/PropertyLayout.astro';
import img5767 from '../assets/properties/ramalho/IMG_5767.jpeg';
import img5757 from '../assets/properties/ramalho/IMG_5757.jpeg';
import img5759 from '../assets/properties/ramalho/IMG_5759.jpeg';
import img5762 from '../assets/properties/ramalho/IMG_5762.jpeg';
import img5764 from '../assets/properties/ramalho/IMG_5764.jpeg';
import img5783 from '../assets/properties/ramalho/IMG_5783.jpeg';
import img5790 from '../assets/properties/ramalho/IMG_5790.jpeg';
import img5791 from '../assets/properties/ramalho/IMG_5791.jpeg';
import img5800 from '../assets/properties/ramalho/IMG_5800.jpeg';
import img5809 from '../assets/properties/ramalho/IMG_5809.jpeg';
import img5810 from '../assets/properties/ramalho/IMG_5810.jpeg';
import img3023 from '../assets/properties/ramalho/IMG_3023 (1).JPG';
import img3059 from '../assets/properties/ramalho/IMG_3059 (1).JPG';
import img20190524 from '../assets/properties/ramalho/20190524_180411.jpg';

const amenities = [
  { name: "High-speed WiFi",  icon: "📶" },
  { name: "Full kitchen",     icon: "🍽️" },
  { name: "Smart TV",         icon: "📺" },
  { name: "Washing machine",  icon: "🧺" },
  { name: "Hair dryer",       icon: "💇" },
  { name: "Microwave",        icon: "📦" },
  { name: "Coffee machine",   icon: "☕" },
  { name: "3 bedrooms",       icon: "🛌" },
];

const galleryImages = [
  img5757, img5759, img5762, img5764, img5783,
  img5790, img5791, img5800, img5809, img5810,
  img3023, img3059, img20190524,
];
---

<PropertyLayout
  title="Ramalho Three Bedroom Apartment – Ramalho Apartments"
  propertyName="Ramalho Three Bedroom Apartment"
  description="Spacious three-bedroom apartment in the heart of Ponta Delgada — comfortably sleeping up to 6 guests."
  heroImage={img5767}
  {galleryImages}
  {amenities}
  price="€60"
  priceNote="2-night minimum stay"
  waMessage="Hi! I'd like to check availability for the Ramalho Three Bedroom Apartment."
  mapEmbedUrl="https://maps.google.com/maps?q=Rua+Rodrigo+Rodrigues+4%2C+Ponta+Delgada%2C+Azores&output=embed&z=17"
>
  <div>
    <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-text-2); margin-bottom:0.5rem;">Home · Ponta Delgada, Azores</p>
    <p style="font-size:0.85rem; color:var(--clr-text-2); margin-bottom:1rem;">3 bedrooms · 3 beds · 2 baths · up to 6 guests</p>
    <hr class="divider" />
    <h2 style="font-size:1.1rem; margin-bottom:0.875rem;">About this place</h2>
    <p style="font-size:0.875rem; line-height:1.75; margin-bottom:0.875rem;">
      Located at <strong>Rua Rodrigo Rodrigues nº4</strong>, this spacious three-bedroom apartment offers a generous home-from-home experience right in the heart of Ponta Delgada, comfortably sleeping up to 6 guests. Ideal for families, groups of friends, or anyone who values extra space to spread out.
    </p>
    <p style="font-size:0.875rem; line-height:1.75;">
      Period architecture meets thoughtful modern touches — you're just steps from the city's best restaurants, cafés, and historic landmarks, with everything you need for a comfortable stay right at hand.
    </p>
  </div>
</PropertyLayout>
