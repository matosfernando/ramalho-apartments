---
import PropertyLayout from '../layouts/PropertyLayout.astro';

const amenities = [
  { name: "High-speed WiFi",      icon: "📶" },
  { name: "Air conditioning",     icon: "❄️" },
  { name: "Full kitchen",         icon: "🍽️" },
  { name: "Smart TV",             icon: "📺" },
  { name: "Washing machine",      icon: "🧺" },
  { name: "Hair dryer",           icon: "💇" },
  { name: "Microwave",            icon: "📦" },
  { name: "Coffee machine",       icon: "☕" },
];

const galleryImages = [
  "https://images.unsplash.com/photo-1540932239986-310128078ceb?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=400&fit=crop",
];
---

<PropertyLayout
  title="Classic City Stay – Ramalho Apartments"
  propertyName="Classic City Stay"
  description="Charming apartment in the heart of Ponta Delgada — modern amenities with historic character."
  heroImage="https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=1200&h=800&fit=crop"
  {galleryImages}
  {amenities}
  price="€60"
  priceNote="3-night minimum stay"
  waMessage="Hi! I'd like to check availability for the Classic City Stay."
  mapEmbedUrl="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.216436308911!2d-25.663055!3d37.7412361!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xf2f3c8d8d8d8d8d%3A0x0!2sPonta%20Delgada!5e0!3m2!1sen!2spt!4v1234567890"
>
  <div>
    <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-text-2); margin-bottom:0.5rem;">Home · Ponta Delgada, Azores</p>
    <p style="font-size:0.85rem; color:var(--clr-text-2); margin-bottom:1rem;">1 bedroom · 1 bed · 1 bath</p>
    <hr class="divider" />
    <h2 style="font-size:1.1rem; margin-bottom:0.875rem;">About this place</h2>
    <p style="font-size:0.875rem; line-height:1.75; margin-bottom:0.875rem;">
      The Classic City Stay is the perfect base for exploring Ponta Delgada. Sitting in the heart of the city centre, you're within walking distance of the best restaurants, cafés, and historic landmarks.
    </p>
    <p style="font-size:0.875rem; line-height:1.75;">
      Period architecture meets modern comforts — the charm of the Azores with every contemporary convenience you need for a great stay.
    </p>
  </div>
</PropertyLayout>
