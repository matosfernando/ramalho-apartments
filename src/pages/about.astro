---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';

const title = "About & Contact - Ramalho Apartments";
const description = "Learn about the Ramalho Apartments story and get in touch with our team.";
---

<Layout {title} {description}>
  <!-- Hero -->
  <HeroSection 
    title="About Ramalho Apartments"
    subtitle="A passion for hospitality and the Azores"
    backgroundImage="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&h=1080&fit=crop"
  />

  <!-- Story Section -->
  <section class="section-padding bg-white">
    <div class="container-max">
      <div class="max-w-3xl mx-auto">
        <h2 class="mb-8">Our Story</h2>
        
        <div class="prose prose-lg text-azure-volcanic space-y-6 mb-12">
          <p>
            Ramalho Apartments was born from a simple idea: to share the beauty and warmth of Ponta Delgada and the Azores with travelers who seek authentic experiences over impersonal transactions.
          </p>

          <p>
            As lifelong residents of Ponta Delgada, we saw countless visitors searching for connections to local culture, honest recommendations, and genuine hospitality. The available options often felt corporate and disconnected from the real Azores we love.
          </p>

          <p>
            So we decided to do something different. We carefully selected three apartments in the heart of our beloved city, each with its own character but all with one thing in common: they're places where we'd be happy hosting friends and family.
          </p>

          <p>
            Today, Ramalho Apartments isn't just a rental business. It's a gateway to genuine Azorean hospitality. When you stay with us, you're getting insider tips, local recommendations, and personal service from people who truly know and love this place.
          </p>

          <p>
            We believe in booking direct. No algorithms, no booking platforms taking commissions, no impersonal customer service centers. Just us, your hosts, dedicated to making your stay unforgettable.
          </p>
        </div>

        <hr class="my-12 border-azure-light" />

        <h2 class="mb-8">Our Values</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <div class="text-center">
            <div class="text-5xl mb-4">🏡</div>
            <h4>Authentic Homes</h4>
            <p class="text-sm text-azure-volcanic">
              Real apartments for real people, not sterile hotel rooms.
            </p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-4">❤️</div>
            <h4>Genuine Care</h4>
            <p class="text-sm text-azure-volcanic">
              Your comfort and satisfaction matter more than profit.
            </p>
          </div>
          <div class="text-center">
            <div class="text-5xl mb-4">🌍</div>
            <h4>Local Love</h4>
            <p class="text-sm text-azure-volcanic">
              We share our community, not just a listing.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding bg-gradient-to-br from-azure-deep/5 to-azure-accent/5">
    <div class="container-max">
      <div class="text-center mb-12 md:mb-16">
        <h2 class="mb-4">Get in Touch</h2>
        <p class="text-lg text-azure-volcanic max-w-2xl mx-auto">
          Have questions? Need recommendations? Want to book? We're here to help and would love to hear from you.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-3xl mx-auto">
        <!-- WhatsApp -->
        <a href="https://wa.me/351918881000" target="_blank" rel="noopener noreferrer" class="bg-white rounded-lg p-8 text-center shadow-lg hover:shadow-xl transition-shadow card-hover group">
          <div class="text-5xl mb-4">💬</div>
          <h4 class="mb-2 group-hover:text-azure-accent">WhatsApp</h4>
          <p class="text-sm text-azure-volcanic mb-4">Instant messaging for quick questions</p>
          <p class="font-semibold text-azure-accent">+351 918 881 000</p>
        </a>

        <!-- Email -->
        <a href="mailto:hello@ramalho.pt" class="bg-white rounded-lg p-8 text-center shadow-lg hover:shadow-xl transition-shadow card-hover group">
          <div class="text-5xl mb-4">✉️</div>
          <h4 class="mb-2 group-hover:text-azure-accent">Email</h4>
          <p class="text-sm text-azure-volcanic mb-4">For detailed inquiries and bookings</p>
          <p class="font-semibold text-azure-accent">hello@ramalho.pt</p>
        </a>

        <!-- Phone -->
        <a href="tel:+351918881000" class="bg-white rounded-lg p-8 text-center shadow-lg hover:shadow-xl transition-shadow card-hover group">
          <div class="text-5xl mb-4">📞</div>
          <h4 class="mb-2 group-hover:text-azure-accent">Phone</h4>
          <p class="text-sm text-azure-volcanic mb-4">For direct conversation</p>
          <p class="font-semibold text-azure-accent">+351 918 881 000</p>
        </a>
      </div>

      <!-- Social Links -->
      <div class="text-center mt-12">
        <h3 class="mb-6">Follow Us</h3>
        <div class="flex justify-center gap-6">
          <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="text-azure-accent hover:text-azure-accent-dark transition-colors">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.057-1.645.069-4.849.069-3.204 0-3.584-.012-4.849-.069-3.259-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.322a1.44 1.44 0 110.001 2.881 1.44 1.44 0 01-.001-2.881z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="text-azure-accent hover:text-azure-accent-dark transition-colors">
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Map -->
  <section class="section-padding bg-white">
    <div class="container-max">
      <h2 class="text-center mb-12">Visit Us in Ponta Delgada</h2>
      <div class="rounded-lg overflow-hidden shadow-lg h-96">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.216436308911!2d-25.663055!3d37.7412361!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xf2f3c8d8d8d8d8d%3A0x0!2sPonta%20Delgada%20City%20Center!5e0!3m2!1sen!2spt!4v1234567890"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    </div>
  </section>
</Layout>
