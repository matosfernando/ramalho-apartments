---
import Layout from '../layouts/Layout.astro';

const title = "Ponta Delgada Guide: Top Spots & Tips | Ramalho";
const description = "A resident guide to Ponta Delgada and São Miguel: must-see spots, supermarkets, pharmacies, car hire and getting in from the airport, by your hosts.";

const topSpots = [
  { name: "Forte de São Brás",        desc: "Historic fortress with panoramic city views and Azorean military history.",         img: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=400&fit=crop" },
  { name: "Jardim António Borges",    desc: "Enchanting botanical garden with exotic plants and peaceful walking paths.",         img: "https://images.unsplash.com/photo-1516912481808-3406841bd33c?w=600&h=400&fit=crop" },
  { name: "Arcos da Cidade",          desc: "Iconic city gate surrounded by charming cobblestone streets.",                      img: "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&h=400&fit=crop" },
  { name: "Monte Palace Viewpoint",   desc: "Spectacular panoramic views over Ponta Delgada and the coast.",                     img: "https://images.unsplash.com/photo-1506197603052-3cc9c3a201bd?w=600&h=400&fit=crop" },
  { name: "Lagoa de Santiago",        desc: "Beautiful crater lake — perfect for swimming and picnics.",                         img: "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&h=400&fit=crop" },
];

const essentials = [
  { name: "Mercado da Graça",                  type: "Supermarket",    icon: "🛒", address: "Rua da Graça" },
  { name: "Continente",                        type: "Shopping",       icon: "🏬", address: "Av. Infante Dom Henrique" },
  { name: "Farmácia Central",                  type: "Pharmacy",       icon: "💊", address: "Rua da Avenida" },
  { name: "Hospital Divino Espírito Santo",    type: "Hospital",       icon: "🏥", address: "Av. D. João III" },
  { name: "CTT Correios",                      type: "Post Office",    icon: "📮", address: "Av. Infante Dom Henrique" },
  { name: "Tourist Information",               type: "Info Center",    icon: "ℹ️",  address: "Av. Infante Dom Henrique" },
];

const logistics = [
  {
    title: "Getting around",
    items: ["Rental cars available at the airport and city center", "SpotAzores app for taxis and ride-sharing", "Local buses connect the city to nearby attractions", "Walking is ideal for central Ponta Delgada"],
  },
  {
    title: "Getting here",
    items: ["João Paulo II Airport is just 2 km from the city center", "TAP Air Portugal operates most routes", "Taxi or ride-share to center (~10 minutes)", "Rental car pickup available at the airport"],
  },
  {
    title: "Car rentals",
    items: ["International agencies at the airport", "Local agencies offer competitive rates", "SpotAzores app includes car rental services", "EU or International driving licence required"],
  },
];
---

<Layout {title} {description}>

  <!-- Page header -->
  <section style="background: var(--clr-bg-subtle); border-bottom: 1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block: 3rem 2.5rem;">
      <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--clr-text-2); margin-bottom:0.75rem;">Local guide</p>
      <h1 style="max-width:580px; margin-bottom:1rem;">Ponta Delgada & São Miguel</h1>
      <p style="font-size:1rem; max-width:520px; line-height:1.7;">
        Insider tips from residents. The best spots, practical essentials, and how to get around the Azores.
      </p>
    </div>
  </section>

  <!-- Top spots -->
  <section>
    <div class="page-wrap section">
      <h2 style="font-size:1.3rem; margin-bottom:0.5rem;">Must-see spots</h2>
      <p style="margin-bottom:2rem; max-width:520px;">Five iconic places that capture the heart of São Miguel.</p>

      <div class="spots-grid">
        {topSpots.map((spot, i) => (
          <article class="spot-card">
            <div style="overflow:hidden; border-radius:var(--radius-card); aspect-ratio:16/9; margin-bottom:0.875rem;">
              <img
                src={spot.img}
                {/* Deliberately empty. These are generic Unsplash stock photos, not
                    pictures of these places — and two of the five entries reuse the
                    same image. Naming the landmark in alt text would assert something
                    untrue to anyone who cannot see the image. The <h3> beneath names
                    the place, so nothing is lost. Replace with real photos and this
                    becomes descriptive alt text. */}
                alt=""
                width="600" height="338" loading={i < 2 ? "eager" : "lazy"}
                style="width:100%; height:100%; object-fit:cover; transition: transform 0.35s ease; display:block;"
                class="spot-img"
              />
            </div>
            <h3 style="font-size:0.95rem; margin-bottom:0.3rem;">{spot.name}</h3>
            <p style="font-size:0.82rem; line-height:1.6;">{spot.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Essentials -->
  <section style="background: var(--clr-bg-subtle); border-top:1px solid var(--clr-border-light); border-bottom:1px solid var(--clr-border-light);">
    <div class="page-wrap section">
      <h2 style="font-size:1.3rem; margin-bottom:0.5rem;">Local essentials</h2>
      <p style="margin-bottom:2rem; max-width:480px;">Services you might need during your stay.</p>

      <div class="essentials-grid">
        {essentials.map(e => (
          <div class="essential-card">
            <span style="font-size:1.3rem; line-height:1;" aria-hidden="true">{e.icon}</span>
            <div>
              <p style="font-size:0.875rem; font-weight:600; color:var(--clr-text); margin-bottom:0.1rem;">{e.name}</p>
              <p style="font-size:0.78rem; color:var(--clr-text-2); margin-bottom:0.1rem;">{e.type}</p>
              <p style="font-size:0.78rem; color:var(--clr-text-2);">{e.address}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transport -->
  <section>
    <div class="page-wrap section">
      <h2 style="font-size:1.3rem; margin-bottom:0.5rem;">Logistics & transport</h2>
      <p style="margin-bottom:2rem; max-width:520px;">Everything you need to arrive and get around São Miguel.</p>

      <div class="logistics-grid">
        {logistics.map(section => (
          <div class="logistics-card">
            <h3 style="font-size:0.95rem; margin-bottom:1.1rem;">{section.title}</h3>
            <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.7rem;">
              {section.items.map(item => (
                <li style="display:flex; gap:0.6rem; align-items:flex-start; font-size:0.85rem; color:var(--clr-text-2);">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:2px;" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- SpotAzores callout -->
      <div style="margin-top:2.5rem; background:#111; color:#fff; border-radius:var(--radius-card); padding: 2rem 2.5rem; display:flex; flex-wrap:wrap; gap:2rem; align-items:center; justify-content:space-between;">
        <div>
          <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:rgba(255,255,255,0.5); margin-bottom:0.5rem;">Recommended app</p>
          <h3 style="color:#fff; font-size:1.1rem; margin-bottom:0.4rem;">SpotAzores</h3>
          <p style="color:rgba(255,255,255,0.7); font-size:0.875rem; max-width:380px; line-height:1.6;">Real-time taxis, car rentals, and local information — your one-stop app for getting around the Azores.</p>
        </div>
        <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="color:#fff; border-color:rgba(255,255,255,0.4); flex-shrink:0;">
          Download app
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background: var(--clr-bg-subtle); border-top:1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block:3rem; text-align:center;">
      <h2 style="font-size:1.3rem; margin-bottom:0.75rem;">Questions about your visit?</h2>
      <p style="max-width:400px; margin-inline:auto; margin-bottom:1.75rem; line-height:1.7;">
        We know Ponta Delgada inside and out. Ask us anything.
      </p>
      <a
        href="https://wa.me/351911031847?text=Hi! I have some questions about visiting Ponta Delgada."
        target="_blank" rel="noopener noreferrer"
        class="btn btn-whatsapp"
      >
        Message us on WhatsApp
      </a>
    </div>
  </section>

</Layout>

<style>
.spots-grid {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: 1fr;
}
@media (min-width: 640px)  { .spots-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .spots-grid { grid-template-columns: repeat(3, 1fr); } }

.spot-card:hover .spot-img { transform: scale(1.04); }

.essentials-grid {
  display: grid;
  gap: 0.875rem;
  grid-template-columns: 1fr;
}
@media (min-width: 640px)  { .essentials-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .essentials-grid { grid-template-columns: repeat(3, 1fr); } }

.essential-card {
  display: flex;
  gap: 0.875rem;
  align-items: flex-start;
  padding: 1rem 1.25rem;
  background: var(--clr-bg);
  border: 1px solid var(--clr-border-light);
  border-radius: var(--radius-card);
}

.logistics-grid {
  display: grid;
  gap: 1.25rem;
  grid-template-columns: 1fr;
}
@media (min-width: 768px)  { .logistics-grid { grid-template-columns: repeat(3, 1fr); } }

.logistics-card {
  padding: 1.5rem;
  background: var(--clr-bg-subtle);
  border: 1px solid var(--clr-border-light);
  border-radius: var(--radius-card);
}
</style>
