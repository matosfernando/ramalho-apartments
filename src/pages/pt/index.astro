---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PropertyCarousel from '../../components/PropertyCarousel.astro';
import { useTranslations } from '../../i18n/utils';
import { imageAlt } from '../../i18n/image-alt';
import ramalhoHero from '../../assets/properties/ramalho/IMG_5767.jpeg';
import amorimHero from '../../assets/properties/amorim/Screenshot 2026-05-03 145515.png';
import duplexHero from '../../assets/properties/duplex/Screenshot 2026-05-03 145842.png';
import heroImage from '../../assets/images/header 2026-05-03_200655.jpg';
import aboutImage from '../../assets/images/Presentation1.png';

const locale = 'pt';
const t = useTranslations(locale);

const title = t('site.default_title');
const description = t('site.default_description');

const properties = [
  {
    title:        "Apartamento Ramalho T3",
    image:        ramalhoHero,
imageAlt:    imageAlt[locale].ramalho[0],
    href:         "/pt/ramalho/",
    price:        "€80",
    rating:       9.3,
    ratingScale:  10,
    ratingSource: "Booking.com",
    ratingUrl:    "https://www.booking.com/hotel/pt/ramalho-apartments-t3-cidade-ponta-delgada.html",
    bedrooms:     3,
    beds:         3,
    baths:        2,
  },
  {
    title:       "Apartamento Amorim T2",
    image:       amorimHero,
imageAlt:    imageAlt[locale].amorim[0],
    href:        "/pt/amorim/",
    openingDate: "Outubro 2026",
    bedrooms:    2,
    beds:        2,
    baths:       1,
  },
  {
    title:       "Duplex Amorim T2",
    image:       duplexHero,
imageAlt:    imageAlt[locale].duplex[0],
    href:        "/pt/amorim-duplex/",
    openingDate: "Outubro 2026",
    bedrooms:    2,
    beds:        2,
    baths:       2,
  },
];
---

<Layout {title} {description} {locale}>

  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="hero">
    <Image
      src={heroImage}
      alt=""
      class="hero-bg"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="hero-overlay" />
    <div class="hero-content page-wrap">
      <p style="color:rgba(255,255,255,0.8); font-size:0.85rem; font-weight:500; letter-spacing:0.06em; text-transform:uppercase; margin-bottom:0.75rem;">
        {t('hero.eyebrow')}
      </p>
      <h1 style="color:#fff; max-width:600px; text-shadow:0 2px 24px rgba(0,0,0,0.2);">
        {t('hero.h1')}
      </h1>
      <p style="color:rgba(255,255,255,0.85); margin-top:0.875rem; font-size:1rem; max-width:420px; line-height:1.65;">
        {t('hero.subtext')}
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:1.75rem;">
        <a
          href={`https://wa.me/351911031847?text=${encodeURIComponent(t('hero.wa_message'))}`}
          target="_blank" rel="noopener noreferrer"
          class="btn btn-whatsapp btn-lg"
        >
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
          </svg>
          {t('hero.cta_whatsapp')}
        </a>
        <a href="#properties" class="btn btn-outline" style="color:#fff; border-color:rgba(255,255,255,0.6);">
          {t('hero.cta_browse')}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Trust strip ────────────────────────────────────── -->
  <section style="border-bottom: 1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block: 2rem;">
      <div class="value-strip">
        <div class="value-item">
          <span class="value-item-icon">⭐</span>
          <span class="value-item-title">{t('trust.rating_title')}</span>
          <span class="value-item-desc">{t('trust.rating_desc')}</span>
        </div>
        <div class="value-item">
          <span class="value-item-icon">💰</span>
          <span class="value-item-title">{t('trust.rate_title')}</span>
          <span class="value-item-desc">{t('trust.rate_desc')}</span>
        </div>
        <div class="value-item">
          <span class="value-item-icon">🗺️</span>
          <span class="value-item-title">{t('trust.tips_title')}</span>
          <span class="value-item-desc">{t('trust.tips_desc')}</span>
        </div>
        <div class="value-item">
          <span class="value-item-icon">💬</span>
          <span class="value-item-title">{t('trust.support_title')}</span>
          <span class="value-item-desc">{t('trust.support_desc')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Property carousel ──────────────────────────────── -->
  <div id="properties">
    <PropertyCarousel {properties} {locale} />
  </div>

  <!-- ── About strip ────────────────────────────────────── -->
  <section style="background: var(--clr-bg-subtle);">
    <div class="page-wrap section">
      <div style="display:grid; gap:3rem; align-items:center;" class="about-grid">
        <div>
          <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--clr-text-2); margin-bottom:0.75rem;">{t('about_strip.eyebrow')}</p>
          <h2 style="max-width:440px; margin-bottom:1.25rem;">{t('about_strip.h2')}</h2>
          <p style="max-width:460px; line-height:1.7; margin-bottom:1.75rem;">
            {t('about_strip.body')}
          </p>
          <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
            <a href="/pt/about/" class="btn btn-dark">{t('about_strip.cta_story')}</a>
          </div>
        </div>
        <div style="overflow:hidden; border-radius: var(--radius-card);">
          <Image
            src={aboutImage}
            alt={t('about_strip.img_alt')}
            widths={[600, 900]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="lazy"
            style="width:100%; height:340px; object-fit:cover; display:block;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA banner ─────────────────────────────────────── -->
  <section style="background: #111; color:#fff;">
    <div class="page-wrap" style="padding-block:4rem; text-align:center;">
      <h2 style="color:#fff; max-width:500px; margin-inline:auto; margin-bottom:0.875rem;">
        {t('cta_banner.h2')}
      </h2>
      <p style="color:rgba(255,255,255,0.7); max-width:400px; margin-inline:auto; margin-bottom:2rem; line-height:1.65;">
        {t('cta_banner.body')}
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:0.75rem; justify-content:center;">
        <a
          href={`https://wa.me/351911031847?text=${encodeURIComponent(t('cta_banner.wa_message'))}`}
          target="_blank" rel="noopener noreferrer"
          class="btn btn-whatsapp btn-lg"
        >
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
          </svg>
          {t('cta_banner.whatsapp')}
        </a>
        <a href="mailto:ramalhoapartments@gmail.com" class="btn btn-outline" style="color:#fff; border-color:rgba(255,255,255,0.4);">
          {t('cta_banner.email')}
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
.about-grid {
  grid-template-columns: 1fr;
}
@media (min-width: 1024px) {
  .about-grid { grid-template-columns: 1fr 1fr; }
}
</style>
