---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import storyImage from '../../assets/images/pexels-ihor-lypnytskyi-117692765-17162633.jpg';

const locale = 'pt';
const t = useTranslations(locale);

const title = t('about.title');
const description = t('about.description');
---

<Layout {title} {description} {locale}>

  <!-- Page header -->
  <section style="background: var(--clr-bg-subtle); border-bottom: 1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block: 3.5rem 3rem;">
      <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--clr-text-2); margin-bottom:0.75rem;">{t('about.eyebrow')}</p>
      <h1 style="max-width:560px; margin-bottom:1rem;">{t('about.h1')}</h1>
      <p style="font-size:1rem; max-width:540px; line-height:1.7;">
        {t('about.intro')}
      </p>
    </div>
  </section>

  <!-- Story -->
  <section>
    <div class="page-wrap" style="padding-block: 3.5rem;">
      <div class="story-grid">
        <div>
          <h2 style="font-size:1.3rem; margin-bottom:1.5rem;">{t('about.story_h2')}</h2>
          <div class="story-body">
            <p>{t('about.story_p1')}</p>
            <p>{t('about.story_p2')}</p>
            <p>{t('about.story_p3')}</p>
            <p>{t('about.story_p4')}</p>
          </div>
        </div>
        <div>
          <Image
            src={storyImage}
            alt={t('about.story_img_alt')}
            widths={[600, 900]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="lazy"
            style="width:100%; height:auto; display:block; border-radius:var(--radius-card);"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section style="border-top:1px solid var(--clr-border-light); border-bottom:1px solid var(--clr-border-light); background: var(--clr-bg-subtle);">
    <div class="page-wrap" style="padding-block:3.5rem;">
      <h2 style="font-size:1.3rem; margin-bottom:2rem;">{t('about.values_h2')}</h2>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-card-icon" aria-hidden="true">🏡</div>
          <h3 style="font-size:1rem; margin-bottom:0.4rem;">{t('about.value1_title')}</h3>
          <p style="font-size:0.875rem; line-height:1.65;">{t('about.value1_desc')}</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon" aria-hidden="true">❤️</div>
          <h3 style="font-size:1rem; margin-bottom:0.4rem;">{t('about.value2_title')}</h3>
          <p style="font-size:0.875rem; line-height:1.65;">{t('about.value2_desc')}</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon" aria-hidden="true">🌍</div>
          <h3 style="font-size:1rem; margin-bottom:0.4rem;">{t('about.value3_title')}</h3>
          <p style="font-size:0.875rem; line-height:1.65;">{t('about.value3_desc')}</p>
        </div>
        <div class="value-card">
          <div class="value-card-icon" aria-hidden="true">💰</div>
          <h3 style="font-size:1rem; margin-bottom:0.4rem;">{t('about.value4_title')}</h3>
          <p style="font-size:0.875rem; line-height:1.65;">{t('about.value4_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section>
    <div class="page-wrap" style="padding-block:3.5rem;">
      <h2 style="font-size:1.3rem; margin-bottom:0.5rem;">{t('about.contact_h2')}</h2>
      <p style="margin-bottom:2rem; max-width:440px; line-height:1.7;">
        {t('about.contact_intro')}
      </p>

      <div class="contact-grid">
        <!-- WhatsApp -->
        <a href="https://wa.me/351911031847" target="_blank" rel="noopener noreferrer" class="contact-card">
          <div class="contact-icon" style="background:#e7fced;">
            <svg width="22" height="22" fill="#25D366" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
            </svg>
          </div>
          <div>
            <p style="font-size:0.875rem; font-weight:600; color:var(--clr-text); margin-bottom:0.2rem;">{t('about.wa_label')}</p>
            <p style="font-size:0.82rem;">{t('about.wa_desc')}</p>
            <p style="font-size:0.82rem; font-weight:500; color:var(--clr-text); margin-top:0.25rem;">+351 911 031 847</p>
          </div>
        </a>

        <!-- Email -->
        <a href="mailto:ramalhoapartments@gmail.com" class="contact-card">
          <div class="contact-icon" style="background:#eef0ff;">
            <svg width="20" height="20" fill="none" stroke="#5860f0" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p style="font-size:0.875rem; font-weight:600; color:var(--clr-text); margin-bottom:0.2rem;">{t('about.email_label')}</p>
            <p style="font-size:0.82rem;">{t('about.email_desc')}</p>
            <p style="font-size:0.82rem; font-weight:500; color:var(--clr-text); margin-top:0.25rem;">ramalhoapartments@gmail.com</p>
          </div>
        </a>

        <!-- Phone -->
        <a href="tel:+351911031847" class="contact-card">
          <div class="contact-icon" style="background:#fff4ec;">
            <svg width="20" height="20" fill="none" stroke="#f97316" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div>
            <p style="font-size:0.875rem; font-weight:600; color:var(--clr-text); margin-bottom:0.2rem;">{t('about.phone_label')}</p>
            <p style="font-size:0.82rem;">{t('about.phone_desc')}</p>
            <p style="font-size:0.82rem; font-weight:500; color:var(--clr-text); margin-top:0.25rem;">+351 911 031 847</p>
          </div>
        </a>
      </div>

      <!-- Map -->
      <div style="margin-top:3rem;">
        <h2 style="font-size:1.1rem; margin-bottom:0.375rem;">{t('about.map_h2')}</h2>
        <p style="font-size:0.82rem; color:var(--clr-text-2); margin-bottom:1rem;">{t('about.map_subtext')}</p>

        <div class="map-tabs" role="tablist" aria-label="Localizações das propriedades">
          <button class="map-tab map-tab--active" role="tab" aria-selected="true"  data-map="ramalho" data-info="info-ramalho">{t('about.map_tab_ramalho')}</button>
          <button class="map-tab"                 role="tab" aria-selected="false" data-map="amorim"  data-info="info-amorim" >{t('about.map_tab_amorim')}</button>
        </div>

        <div class="map-wrap" style="height:340px;">
          <iframe
            id="about-map-iframe"
            src="https://maps.google.com/maps?q=Rua+Rodrigo+Rodrigues+4%2C+Ponta+Delgada%2C+Azores&output=embed&z=17"
            width="100%" height="100%"
            style="border:0; display:block;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de localização da propriedade"
          ></iframe>
        </div>

        <div id="info-ramalho" class="map-info-panel">
          <div class="map-info-row">
            <div>
              <p class="map-info-name">{t('about.map_ramalho_name')}</p>
              <p class="map-info-addr">Rua Rodrigo Rodrigues nº4, Ponta Delgada</p>
            </div>
            <a href="/pt/ramalho" class="btn btn-dark btn-sm">{t('about.map_view_property')}</a>
          </div>
        </div>

        <div id="info-amorim" class="map-info-panel" style="display:none;">
          <div class="map-info-row">
            <div>
              <p class="map-info-name">{t('about.map_amorim_name')}</p>
              <p class="map-info-addr">Rua do Amorim 15, Ponta Delgada</p>
            </div>
            <div style="display:flex; gap:0.5rem; flex-shrink:0;">
              <a href="/pt/amorim"        class="btn btn-dark btn-sm">{t('about.map_apartment_btn')}</a>
              <a href="/pt/amorim-duplex" class="btn btn-dark btn-sm">{t('about.map_duplex_btn')}</a>
            </div>
          </div>
        </div>
      </div>

      <script is:inline>
        (function () {
          var maps = {
            ramalho: 'https://maps.google.com/maps?q=Rua+Rodrigo+Rodrigues+4%2C+Ponta+Delgada%2C+Azores&output=embed&z=17',
            amorim:  'https://maps.google.com/maps?q=Rua+do+Amorim+15%2C+Ponta+Delgada%2C+Azores&output=embed&z=17'
          };
          var tabs   = document.querySelectorAll('.map-tab');
          var iframe = document.getElementById('about-map-iframe');

          tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
              var key  = this.dataset.map;
              var info = this.dataset.info;
              tabs.forEach(function (t) {
                t.classList.remove('map-tab--active');
                t.setAttribute('aria-selected', 'false');
              });
              this.classList.add('map-tab--active');
              this.setAttribute('aria-selected', 'true');
              iframe.src = maps[key];
              document.getElementById('info-ramalho').style.display = 'none';
              document.getElementById('info-amorim').style.display  = 'none';
              document.getElementById(info).style.display = 'block';
            });
          });
        })();
      </script>
    </div>
  </section>

</Layout>

<style>
.story-grid { display: grid; gap: 3rem; align-items: start; grid-template-columns: 1fr; }
@media (min-width: 1024px) { .story-grid { grid-template-columns: 1fr 1fr; } }
.story-body { display: flex; flex-direction: column; gap: 1.1rem; }
.story-body p { font-size: 0.9rem; line-height: 1.75; color: var(--clr-text-2); margin: 0; }
.values-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(2, 1fr); }
@media (min-width: 1024px) { .values-grid { grid-template-columns: repeat(4, 1fr); } }
.value-card { background: var(--clr-bg); border: 1px solid var(--clr-border-light); border-radius: var(--radius-card); padding: 1.5rem; }
.value-card-icon { font-size: 1.75rem; margin-bottom: 0.875rem; }
.contact-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
@media (min-width: 640px)  { .contact-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .contact-grid { grid-template-columns: repeat(3, 1fr); } }
.contact-card { display: flex; gap: 1rem; align-items: flex-start; padding: 1.25rem; border: 1px solid var(--clr-border-light); border-radius: var(--radius-card); background: var(--clr-bg); transition: box-shadow 0.2s ease, border-color 0.2s ease; text-decoration: none; }
.contact-card:hover { box-shadow: var(--shadow-card); border-color: var(--clr-border); }
.contact-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.map-tabs { display: flex; gap: 0.5rem; margin-bottom: 0.875rem; }
.map-tab { padding: 0.45rem 1.1rem; font-size: 0.85rem; font-weight: 500; border: 1px solid var(--clr-border-light); border-radius: 20px; background: var(--clr-bg); color: var(--clr-text-2); cursor: pointer; transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
.map-tab:hover:not(.map-tab--active) { border-color: var(--clr-border); color: var(--clr-text); }
.map-tab--active { background: var(--clr-text); color: #fff; border-color: var(--clr-text); }
.map-info-panel { margin-top: 0.875rem; padding: 1rem 1.25rem; border: 1px solid var(--clr-border-light); border-radius: var(--radius-card); background: var(--clr-bg-subtle); }
.map-info-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.map-info-name { font-size: 0.875rem; font-weight: 600; color: var(--clr-text); margin-bottom: 0.2rem; }
.map-info-addr { font-size: 0.82rem; color: var(--clr-text-2); }
</style>
