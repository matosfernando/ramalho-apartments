---
import PropertyLayout from '../layouts/PropertyLayout.astro';
import duplexHero from '../assets/properties/duplex/Screenshot 2026-05-03 145842.png';
import duplex2 from '../assets/properties/duplex/Screenshot 2026-05-03 145744.png';
import duplex3 from '../assets/properties/duplex/Screenshot 2026-05-03 145812.png';
import duplex4 from '../assets/properties/duplex/Screenshot 2026-05-03 145912.png';
import duplex5 from '../assets/properties/duplex/Screenshot 2026-05-03 145936.png';
import duplex6 from '../assets/properties/duplex/Screenshot 2026-05-03 150002.png';
import duplex7 from '../assets/properties/duplex/Screenshot 2026-05-03 150025.png';
import duplex8 from '../assets/properties/duplex/Screenshot 2026-05-03 150055.png';

const amenities = [
  { name: "High-speed WiFi",    icon: "📶" },
  { name: "Air conditioning",   icon: "❄️" },
  { name: "Full kitchen",       icon: "🍽️" },
  { name: "2 bathrooms",        icon: "🚿" },
  { name: "Washing machine",    icon: "🧺" },
  { name: "2 bedrooms",         icon: "🛌" },
  { name: "Large living room",  icon: "🛋️" },
  { name: "Outdoor space",      icon: "🌳" },
];

const galleryImages = [duplex2, duplex3, duplex4, duplex5, duplex6, duplex7, duplex8];
---

<PropertyLayout
  title="Amorim Two Bedroom Duplex – Ramalho Apartments"
  propertyName="Amorim Two Bedroom Duplex"
  description="Split-level two-bedroom duplex on Rua do Amorim — two bathrooms, generous living space, and room for up to 6 guests."
  heroImage={duplexHero}
  {galleryImages}
  {amenities}
  price="€95"
  priceNote="2-night minimum stay"
  waMessage="Hi! I'd like to check availability for the Amorim Two Bedroom Duplex."
  mapEmbedUrl="https://maps.google.com/maps?q=Rua+do+Amorim+15%2C+Ponta+Delgada%2C+Azores&output=embed&z=17"
>
  <div>
    <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-text-2); margin-bottom:0.5rem;">Home · Ponta Delgada, Azores</p>
    <p style="font-size:0.85rem; color:var(--clr-text-2); margin-bottom:1rem;">2 bedrooms · 2 beds · 2 baths · up to 6 guests</p>
    <hr class="divider" />
    <h2 style="font-size:1.1rem; margin-bottom:0.875rem;">About this place</h2>
    <p style="font-size:0.875rem; line-height:1.75; margin-bottom:0.875rem;">
      Located at <strong>Rua do Amorim 15, Ponta Delgada</strong>, this well-designed two-bedroom duplex makes full use of its split-level layout to give guests both space and privacy. Two bedrooms, two bathrooms, and a generous open-plan living area make it a comfortable choice for groups of up to 6.
    </p>
    <p style="font-size:0.875rem; line-height:1.75;">
      The upper level offers a peaceful sleeping retreat while the lower level is perfect for shared meals and relaxed evenings together — all in the heart of Ponta Delgada.
    </p>
  </div>
</PropertyLayout>
