---
import PropertyLayout from '../layouts/PropertyLayout.astro';

const amenities = [
  { name: "High-speed WiFi",    icon: "📶" },
  { name: "Air conditioning",   icon: "❄️" },
  { name: "Full kitchen",       icon: "🍽️" },
  { name: "2 bathrooms",        icon: "🚿" },
  { name: "Washing machine",    icon: "🧺" },
  { name: "3 bedrooms",         icon: "🛌" },
  { name: "Large living room",  icon: "🛋️" },
  { name: "Outdoor space",      icon: "🌳" },
];

const galleryImages = [
  "https://images.unsplash.com/photo-1540932239986-310128078ceb?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1578500494198-246f612d03b3?w=600&h=400&fit=crop",
];
---

<PropertyLayout
  title="Family Duplex – Ramalho Apartments"
  propertyName="Family Duplex"
  description="Spacious two-level apartment for families and groups — 3 bedrooms, 2 baths, plenty of shared living space."
  heroImage="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=1200&h=800&fit=crop"
  {galleryImages}
  {amenities}
  price="€95"
  priceNote="2-night minimum · group discounts available"
  waMessage="Hi! I'm interested in booking the Family Duplex."
  mapEmbedUrl="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.216436308911!2d-25.663055!3d37.7412361!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xf2f3c8d8d8d8d8d%3A0x0!2sPonta%20Delgada!5e0!3m2!1sen!2spt!4v1234567890"
>
  <div>
    <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--clr-text-2); margin-bottom:0.5rem;">Home · Ponta Delgada, Azores</p>
    <p style="font-size:0.85rem; color:var(--clr-text-2); margin-bottom:1rem;">3 bedrooms · 4 beds · 2 baths</p>
    <hr class="divider" />
    <h2 style="font-size:1.1rem; margin-bottom:0.875rem;">About this place</h2>
    <p style="font-size:0.875rem; line-height:1.75; margin-bottom:0.875rem;">
      Need space for the whole family or a group? The Family Duplex spans two levels with three bedrooms, two bathrooms, and generous shared areas — ideal for multi-generational travel or friend groups.
    </p>
    <p style="font-size:0.875rem; line-height:1.75;">
      The upper level offers privacy for sleeping areas, while the open-plan lower level is perfect for family meals and relaxed evenings together.
    </p>
  </div>
</PropertyLayout>
