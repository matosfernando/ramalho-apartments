---
import PropertyLayout from '../layouts/PropertyLayout.astro';

const title = "Family Duplex - Ramalho Apartments";
const description = "Spacious two-level apartment perfect for families and groups with multiple bedrooms, living spaces, and ample amenities.";

const amenities = [
  { name: "WiFi", icon: "📶" },
  { name: "AC", icon: "❄️" },
  { name: "Full Kitchen", icon: "🍽️" },
  { name: "2 Bathrooms", icon: "🚿" },
  { name: "Washing Machine", icon: "🧺" },
  { name: "2 Bedrooms", icon: "🛌" },
  { name: "Living Room", icon: "🛋️" },
  { name: "Outdoor Space", icon: "🌳" }
];

const galleryImages = [
  "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1540932239986-310128078ceb?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1578500494198-246f612d03b3?w=600&h=400&fit=crop",
  "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=400&fit=crop"
];

const mapEmbedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.216436308911!2d-25.663055!3d37.7412361!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xf2f3c8d8d8d8d8d%3A0x0!2sPonta%20Delgada!5e0!3m2!1sen!2spt!4v1234567890";
---

<PropertyLayout 
  {title} 
  {description}
  heroImage="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=1200&h=600&fit=crop"
  {galleryImages}
  {amenities}
  {mapEmbedUrl}
>
  <!-- Additional Details Section -->
  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h3 class="mb-4">About This Apartment</h3>
          <p class="text-azure-volcanic mb-4">
            Looking for space for your family or group? Our Family Duplex offers two levels of comfortable living with plenty of room for everyone. Two bedrooms, two bathrooms, and plenty of shared spaces make this ideal for multi-generational travel or friend groups.
          </p>
          <p class="text-azure-volcanic">
            The upper level provides privacy for sleeping areas while the lower level features an open-plan living and dining space perfect for family meals and gatherings.
          </p>
        </div>
        
        <div>
          <h3 class="mb-4">Rates & Availability</h3>
          <div class="bg-white rounded-lg p-6 shadow-md">
            <p class="mb-4">
              <span class="text-azure-accent font-bold text-2xl">€95</span>
              <span class="text-azure-volcanic">/night</span>
            </p>
            <p class="text-sm text-azure-volcanic mb-4">
              Minimum stay: 2 nights • Group discounts available
            </p>
            <a href="https://wa.me/351918881000?text=Hi! I'm interested in booking the Family Duplex." class="btn-primary w-full justify-center">
              Check Availability
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PropertyLayout>
