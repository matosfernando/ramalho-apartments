---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '../i18n/utils';
import { propertyData } from '../i18n/properties';
import { imageAlt } from '../i18n/image-alt';
import ramalhoHero from '../assets/properties/ramalho/IMG_5767.jpeg';
import amorimHero from '../assets/properties/amorim/Screenshot 2026-05-03 145515.png';
import duplexHero from '../assets/properties/duplex/Screenshot 2026-05-03 145842.png';

const locale = 'en';
const t = useTranslations(locale);
const pd = propertyData[locale];

const title       = t('properties.meta_title');
const description = t('properties.meta_description');

const properties = [
  {
    ...pd.ramalho,
    slug:        "ramalho",
    heroAlt:     imageAlt[locale].ramalho[0],
    heroImage:   ramalhoHero as ImageMetadata | string,
    openingSoon: false,
  },
  {
    ...pd.amorim,
    slug:        "amorim",
    heroAlt:     imageAlt[locale].amorim[0],
    heroImage:   amorimHero as ImageMetadata | string,
    openingSoon: true,
    openingDate: "October 2026",
  },
  {
    ...pd.duplex,
    slug:        "amorim-duplex",
    heroAlt:     imageAlt[locale].duplex[0],
    heroImage:   duplexHero as ImageMetadata | string,
    openingSoon: true,
    openingDate: "October 2026",
  },
];

---

<Layout {title} {description} {locale}>

  <!-- Page header -->
  <section style="background: var(--clr-bg-subtle); border-bottom: 1px solid var(--clr-border-light);">
    <div class="page-wrap" style="padding-block: 3.5rem 3rem;">
      <p style="font-size:0.78rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:var(--clr-text-2); margin-bottom:0.75rem;">{t('properties.page_eyebrow')}</p>
      <h1 style="max-width:560px; margin-bottom:1rem;">{t('properties.page_h1')}</h1>
      <p style="font-size:1rem; max-width:540px; line-height:1.7;">
        {t('properties.page_intro')}
      </p>
    </div>
  </section>

  <!-- Property listings -->
  <section>
    <div class="page-wrap" style="padding-block: 3.5rem;">
      <div class="property-list">
        {properties.map(p => (
          <article class="property-card">
            <!-- Image -->
            <a href={`/${p.slug}/`} class="property-img-wrap" tabindex="-1" aria-hidden="true">
              {typeof p.heroImage === 'object' ? (
                <Image
                  src={p.heroImage as ImageMetadata}
                  alt={p.heroAlt}
                  width={900} height={600}
                  loading="lazy"
                  class="property-img"
                />
              ) : (
                <img
                  src={p.heroImage}
                  alt={p.heroAlt}
                  width="900" height="600"
                  loading="lazy"
                  class="property-img"
                />
              )}
              {p.badge && (
                <span class="property-badge">{p.badge}</span>
              )}
            </a>

            <!-- Details -->
            <div class="property-details">
              <div class="property-details-inner">
                <div>
                  <p class="property-tagline">{p.tagline}</p>
                  <h2 class="property-name">
                    <a href={`/${p.slug}/`} class="property-name-link">{p.propertyName}</a>
                  </h2>
                  <p class="property-specs">{p.specs}</p>
                  <p class="property-desc">{p.description}</p>

                  <!-- Highlights -->
                  <ul class="property-highlights" aria-label="Key amenities">
                    {p.highlights.map(h => (
                      <li class="property-highlight-chip">{h}</li>
                    ))}
                  </ul>
                </div>

                <!-- Price + CTAs -->
                <div class="property-cta">
                  {p.openingSoon ? (
                    <div class="opening-soon-cta">
                      <div class="opening-soon-label">
                        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        {t('properties.opening')} {'openingDate' in p ? p.openingDate : ''}
                      </div>
                      <div class="property-cta-buttons">
                        <a href={`/${p.slug}/`} class="btn btn-dark">
                          {t('properties.view')}
                        </a>
                        <a
                          href={`mailto:ramalhoapartments@gmail.com?subject=${encodeURIComponent(p.notifyEmailSubject)}&body=${encodeURIComponent(p.notifyEmailBody)}`}
                          class="btn btn-outline"
                        >
                          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                          </svg>
                          {t('properties.get_notified')}
                        </a>
                      </div>
                    </div>
                  ) : (
                    <>
                      {'price' in p && p.price && (
                        <div class="property-price-block">
                          <span class="property-price-from">{t('properties.from')} </span><span class="property-price">{p.price}</span>
                          <span class="property-price-unit"> {t('properties.per_night')}</span>
                          {'priceNote' in p && p.priceNote && <p class="property-price-note">{p.priceNote}</p>}
                        </div>
                      )}
                      <div class="property-cta-buttons">
                        <a href={`/${p.slug}/`} class="btn btn-dark">
                          {t('properties.view')}
                        </a>
                        <a
                          href={`https://wa.me/351911031847?text=${encodeURIComponent(p.waMessage)}`}
                          target="_blank" rel="noopener noreferrer"
                          class="btn btn-whatsapp"
                        >
                          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
                          </svg>
                          {t('properties.book_whatsapp')}
                        </a>
                      </div>
                    </>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section style="border-top: 1px solid var(--clr-border-light); background: var(--clr-bg-subtle);">
    <div class="page-wrap" style="padding-block: 3rem; text-align: center;">
      <h2 style="font-size:1.3rem; margin-bottom:0.75rem;">{t('properties.cta_h2')}</h2>
      <p style="font-size:0.9rem; color:var(--clr-text-2); max-width:420px; margin-inline:auto; line-height:1.7; margin-bottom:1.75rem;">
        {t('properties.cta_body')}
      </p>
      <a
        href={`https://wa.me/351911031847?text=${encodeURIComponent(t('properties.cta_wa_message'))}`}
        target="_blank" rel="noopener noreferrer"
        class="btn btn-whatsapp btn-lg"
      >
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
        </svg>
        {t('properties.cta_whatsapp')}
      </a>
    </div>
  </section>

</Layout>

<style>
/* ── Property list ───────────────────────────────────────── */
.property-list {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

/* ── Property card ───────────────────────────────────────── */
.property-card {
  display: grid;
  grid-template-columns: 1fr;
  border: 1px solid var(--clr-border-light);
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--clr-bg);
  transition: box-shadow 0.2s ease;
}
.property-card:hover { box-shadow: var(--shadow-card); }

@media (min-width: 768px) {
  .property-card { grid-template-columns: 380px 1fr; }
}
@media (min-width: 1024px) {
  .property-card { grid-template-columns: 440px 1fr; }
}

/* ── Image ───────────────────────────────────────────────── */
.property-img-wrap {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 3 / 2;
}
@media (min-width: 768px) { .property-img-wrap { aspect-ratio: unset; } }

.property-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.property-card:hover .property-img { transform: scale(1.03); }

.property-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: var(--clr-text);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.3rem 0.65rem;
  border-radius: 20px;
}

/* ── Details ─────────────────────────────────────────────── */
.property-details {
  display: flex;
  flex-direction: column;
  padding: 1.75rem;
}

.property-details-inner {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.5rem;
  height: 100%;
}

.property-tagline {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--clr-text-2);
  margin-bottom: 0.4rem;
}

.property-name { font-size: 1.25rem; margin-bottom: 0.3rem; }
.property-name-link {
  color: var(--clr-text);
  text-decoration: none;
}
.property-name-link:hover { text-decoration: underline; text-underline-offset: 3px; }

.property-specs {
  font-size: 0.82rem;
  color: var(--clr-text-2);
  margin-bottom: 0.875rem;
}

.property-desc {
  font-size: 0.875rem;
  line-height: 1.75;
  color: var(--clr-text-2);
  margin-bottom: 1.25rem;
}

/* ── Highlights ──────────────────────────────────────────── */
.property-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.property-highlight-chip {
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--clr-text-2);
  background: var(--clr-bg-subtle);
  border: 1px solid var(--clr-border-light);
  border-radius: 20px;
  padding: 0.25rem 0.75rem;
}

/* ── CTA block ───────────────────────────────────────────── */
.property-cta {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--clr-border-light);
}

@media (min-width: 480px) {
  .property-cta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.property-price-block { line-height: 1.2; }
.property-price-from  { font-size: 0.85rem; color: var(--clr-text-2); font-weight: 400; }
.property-price       { font-size: 1.25rem; font-weight: 700; color: var(--clr-text); }
.property-price-unit  { font-size: 0.85rem; color: var(--clr-text-2); font-weight: 400; }
.property-price-note  { font-size: 0.78rem; color: var(--clr-text-2); margin-top: 0.2rem; }

/* Opening soon CTA */
.opening-soon-cta {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 100%;
}

@media (min-width: 480px) {
  .opening-soon-cta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.opening-soon-label {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--clr-text-2);
  background: var(--clr-bg-subtle);
  border: 1px solid var(--clr-border-light);
  border-radius: 20px;
  padding: 0.35rem 0.85rem;
  white-space: nowrap;
}

.property-cta-buttons {
  display: flex;
  gap: 0.625rem;
  flex-wrap: wrap;
}
</style>
