---
/**
 * PropertyLayout Component
 * Shared layout for property pages with image gallery, amenities, and map
 */
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  heroImage: string;
  galleryImages?: string[];
  amenities?: { name: string; icon: string }[];
  mapEmbedUrl?: string;
}

const { title, description, heroImage, galleryImages = [], amenities = [], mapEmbedUrl } = Astro.props as Props;
---

<Layout {title} description={description}>
  <!-- Hero -->
  <section class="relative bg-slate-50">
    <div class="container-max grid gap-10 py-16 lg:grid-cols-[1.4fr_0.9fr] items-center">
      <div class="relative overflow-hidden rounded-[2rem] shadow-2xl h-[420px] md:h-[520px] lg:h-[600px]">
        <img src={heroImage} alt={title} class="w-full h-full object-cover" />
        <div class="gradient-overlay" />
      </div>

      <div class="space-y-8">
        <div class="rounded-[2rem] bg-white border border-slate-200 p-8 shadow-xl">
          <p class="text-sm uppercase tracking-[0.3em] text-slate-500 mb-5">Premium apartment</p>
          <h1 class="text-4xl md:text-5xl tracking-tight text-slate-900 mb-6">{title}</h1>
          <p class="text-base md:text-lg leading-8 text-slate-600">{description}</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-[1.5rem] bg-white border border-slate-200 p-6 shadow-lg">
            <h2 class="text-lg font-semibold text-slate-900 mb-3">Book with confidence</h2>
            <p class="text-sm text-slate-600 leading-7">Reach out directly for the best rates, flexible check-in, and personalized local recommendations.</p>
          </div>
          <div class="rounded-[1.5rem] bg-white border border-slate-200 p-6 shadow-lg">
            <h2 class="text-lg font-semibold text-slate-900 mb-3">Location & access</h2>
            <p class="text-sm text-slate-600 leading-7">Central Ponta Delgada location with easy access to restaurants, beaches, and city highlights.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery and Amenities -->
  <section class="section-padding bg-white">
    <div class="container-max grid gap-10 lg:grid-cols-[1.5fr_0.9fr]">
      {galleryImages.length > 0 && (
        <div>
          <div class="mb-8 flex items-center justify-between gap-4">
            <h2 class="text-2xl font-semibold text-slate-900">Photo gallery</h2>
            <p class="text-sm text-slate-500">Swipe or scroll to preview the space</p>
          </div>
          <div class="grid grid-cols-1 gap-4">
            {galleryImages.map((image, index) => (
              <img key={index} src={image} alt="Property image" class="w-full h-72 object-cover rounded-[1.5rem] shadow-lg" loading="lazy" />
            ))}
          </div>
        </div>
      )}

      {amenities.length > 0 && (
        <div class="sticky top-24 self-start rounded-[2rem] border border-slate-200 bg-slate-50 p-8 shadow-xl">
          <h2 class="text-2xl font-semibold text-slate-900 mb-6">Amenities</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {amenities.map((amenity) => (
              <div key={amenity.name} class="rounded-3xl bg-white p-4 border border-slate-200 shadow-sm">
                <div class="flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-3xl bg-slate-100 text-2xl">{amenity.icon}</div>
                  <p class="font-medium text-slate-900">{amenity.name}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {mapEmbedUrl && (
    <section class="section-padding bg-slate-50">
      <div class="container-max">
        <div class="rounded-[2rem] overflow-hidden border border-slate-200 shadow-xl">
          <iframe
            src={mapEmbedUrl}
            width="100%"
            height="520"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section-padding bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white">
    <div class="container-max flex flex-col gap-6 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-semibold mb-4">Ready to book your stay?</h2>
        <p class="text-base md:text-lg text-slate-300 leading-relaxed">Contact our team directly for availability, local tips, and instant booking support.</p>
      </div>
      <div class="flex flex-col gap-4 sm:flex-row sm:justify-center">
        <a href="https://wa.me/351918881000?text=Hi! I'm interested in booking this property." target="_blank" rel="noopener noreferrer" class="btn-primary justify-center">
          WhatsApp Us
        </a>
        <a href="mailto:hello@ramalho.pt" class="btn-secondary justify-center">
          Email Us
        </a>
      </div>
    </div>
  </section>

  <slot />
</Layout>
