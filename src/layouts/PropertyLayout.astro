---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Amenity { name: string; icon: string; }

type ImageSrc = ImageMetadata | string;

interface Props {
  title: string;
  description: string;
  heroImage: ImageSrc;
  galleryImages?: ImageSrc[];
  amenities?: Amenity[];
  mapEmbedUrl?: string;
  price?: string;
  priceNote?: string;
  propertyName?: string;
  waMessage?: string;
  openingSoon?: boolean;
  openingDate?: string;
}

const {
  title,
  description,
  heroImage,
  galleryImages = [],
  amenities = [],
  mapEmbedUrl,
  price,
  priceNote,
  propertyName,
  waMessage,
  openingSoon = false,
  openingDate,
} = Astro.props as Props;

const displayName = propertyName || title;
const bookingMsg  = waMessage || ("Hi! I'd like to check availability for " + displayName + ".");
const waUrl       = "https://wa.me/351911031847?text=" + encodeURIComponent(bookingMsg);

const allImages: ImageSrc[] = [heroImage, ...galleryImages];
const isLocal = (src: ImageSrc): src is ImageMetadata => typeof src === 'object';
---

<Layout {title} description={description}>

  <!-- Photo header -->
  <section style="position:relative; background:#f7f7f7;">
    <div class="page-wrap" style="padding-top: 1.5rem; padding-bottom: 0;">
      <h1 style="font-size: clamp(1.4rem,3vw,1.9rem); margin-bottom:0.25rem;">{propertyName ?? title}</h1>
      <p style="font-size:0.85rem; color:var(--clr-text-2); margin-bottom:1.25rem;">{description}</p>
    </div>

    <!-- Gallery grid — hero + up to 4 thumbnails -->
    <div class="page-wrap">
      <div class="gallery-grid" id="gallery-grid">
        {allImages.slice(0, 5).map((img, i) => (
          <button
            class={`gallery-cell ${i === 0 ? 'gallery-hero' : ''}`}
            data-index={i}
            aria-label={`View photo ${i + 1} of ${allImages.length}`}
            type="button"
          >
            {isLocal(img) ? (
              <Image
                src={img}
                alt={`${displayName} – photo ${i + 1}`}
                width={i === 0 ? 900 : 450}
                height={i === 0 ? 600 : 300}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="gallery-img"
              />
            ) : (
              <img
                src={img}
                alt={`${displayName} – photo ${i + 1}`}
                width={i === 0 ? 900 : 450}
                height={i === 0 ? 600 : 300}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="gallery-img"
              />
            )}
            {i === 4 && allImages.length > 5 && (
              <div class="gallery-more-overlay">
                <span>+{allImages.length - 5} photos</span>
              </div>
            )}
          </button>
        ))}
      </div>

      {allImages.length > 1 && (
        <button class="show-all-btn" id="show-all-btn" type="button">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
          Show all {allImages.length} photos
        </button>
      )}
    </div>
  </section>

  <!-- Detail layout -->
  <div class="page-wrap" style="padding-top: 2.5rem; padding-bottom: 3rem;">
    <div class="prop-detail-grid">

      <!-- Left column -->
      <div class="prop-detail-main">

        <!-- About slot -->
        <slot />

        <hr class="divider" />

        <!-- Amenities list -->
        {amenities.length > 0 && (
          <div>
            <h2 style="font-size:1.2rem; margin-bottom:1rem;">What this place offers</h2>
            <div class="amenities-list">
              {amenities.map(a => (
                <div class="amenity-chip">
                  <span class="amenity-icon" aria-hidden="true">{a.icon}</span>
                  <span>{a.name}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {mapEmbedUrl && (
          <div>
            <hr class="divider" />
            <div>
              <h2 style="font-size:1.2rem; margin-bottom:1rem;">Where you'll be</h2>
              <div class="map-wrap" style="height:340px;">
                <iframe
                  src={mapEmbedUrl}
                  width="100%"
                  height="100%"
                  style="border:0; display:block;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Property location map"
                />
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Right column - booking sidebar -->
      <aside class="prop-detail-sidebar">
        <div class="booking-card" style="position: sticky; top: 5rem;">
          {openingSoon ? (
            <>
              <div class="coming-soon-header">
                <span class="coming-soon-pill">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Opening {openingDate}
                </span>
                <p class="coming-soon-headline">Be the first to book</p>
                <p class="coming-soon-sub">This property is not yet open. Leave your email and we'll notify you the moment it's available — with an exclusive early-bird offer.</p>
              </div>

              <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:1.25rem;">
                <a
                  href={`mailto:ramalhoapartments@gmail.com?subject=${encodeURIComponent("Notify me – " + displayName)}&body=${encodeURIComponent("Hi,\n\nPlease notify me when " + displayName + " opens for bookings.\n\nName:\nEmail:\n\nThanks!")}`}
                  class="btn btn-notify-lg"
                  style="justify-content:center;"
                >
                  <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                  </svg>
                  Get notified by email
                </a>
                <a
                  href={`https://wa.me/351911031847?text=${encodeURIComponent("Hi! I'd like to be notified when " + displayName + " opens for bookings.")}`}
                  target="_blank" rel="noopener noreferrer"
                  class="btn btn-outline btn-lg"
                  style="justify-content:center;"
                >
                  <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
                  </svg>
                  Notify me on WhatsApp
                </a>
              </div>

              <hr class="divider" style="margin-block:1rem;" />
              <div style="display:flex; flex-direction:column; gap:0.5rem;">
                <div style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.82rem; color:var(--clr-text-2);">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:1px;" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Early-bird priority for waitlist members
                </div>
                <div style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.82rem; color:var(--clr-text-2);">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:1px;" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  No obligation &middot; cancel anytime
                </div>
              </div>
            </>
          ) : (
            <>
              {price && (
                <p style="font-size:1.1rem; font-weight:700; color:var(--clr-text); margin-bottom:0.25rem;">
                  <span style="font-size:0.85rem; font-weight:400; color:var(--clr-text-2);">From </span>{price} <span style="font-size:0.85rem; font-weight:400; color:var(--clr-text-2);">/ night</span>
                </p>
              )}
              {priceNote && (
                <p style="font-size:0.8rem; color:var(--clr-text-2); margin-bottom:1.25rem;">{priceNote}</p>
              )}

              <div style="display:flex; flex-direction:column; gap:0.625rem; margin-bottom:1.25rem;">
                <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg" style="justify-content:center;">
                  <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.869 1.176l-.312.156-.323-.066A9.233 9.233 0 002.73 9.645c-.017.24.06.486.245.683 1.193 1.37 2.845 2.887 4.918 3.921.48.223 1.011.419 1.574.585l.324.082-.088.324c-.247.923-.697 1.785-1.292 2.498-.297.387.104.893.562.893.224 0 .441-.089.618-.25 1.27-1.241 2.255-2.956 2.605-4.764l.067-.319.315.1c2.017.602 3.918 2.003 5.37 3.976.203.256.506.398.831.398.265 0 .518-.098.72-.298l.263-.258c.136-.132.23-.311.271-.502.115-.614.054-1.267-.18-1.922-.403-.994-1.258-1.837-2.22-2.381-1.06-.534-2.146-.75-3.218-.75h-.006z"/>
                  </svg>
                  Book via WhatsApp
                </a>
                <a href="mailto:ramalhoapartments@gmail.com" class="btn btn-outline btn-lg" style="justify-content:center;">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  Send an email
                </a>
              </div>

              <hr class="divider" style="margin-block:1rem;" />

              <div style="display:flex; flex-direction:column; gap:0.5rem;">
                <div style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.82rem; color:var(--clr-text-2);">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:1px;" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Best rate guaranteed - book direct
                </div>
                <div style="display:flex; align-items:flex-start; gap:0.6rem; font-size:0.82rem; color:var(--clr-text-2);">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:1px;" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Flexible check-in &middot; 24/7 support
                </div>
              </div>
            </>
          )}
        </div>
      </aside>
    </div>
  </div>

</Layout>

<!-- Lightbox modal -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo gallery" hidden>
  <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
  <div class="lightbox-inner">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close gallery" type="button">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous photo" type="button">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <div class="lightbox-img-wrap">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <p class="lightbox-counter" id="lightbox-counter"></p>
    </div>

    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next photo" type="button">
      <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Thumbnail strip -->
    <div class="lightbox-thumbs" id="lightbox-thumbs"></div>
  </div>
</div>

<style>
/* ── Gallery grid ──────────────────────────────────────── */
.gallery-grid {
  display: grid;
  gap: 6px;
  grid-template-columns: 1fr;
  border-radius: var(--radius-card);
  overflow: hidden;
  margin-bottom: 0.75rem;
}

@media (min-width: 640px) {
  .gallery-grid {
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
  }
  .gallery-hero {
    grid-row: 1 / 3;
  }
}

@media (min-width: 1024px) {
  .gallery-grid {
    grid-template-rows: 280px 280px;
  }
}

.gallery-cell {
  position: relative;
  overflow: hidden;
  display: block;
  padding: 0;
  border: none;
  background: #e5e5e5;
  cursor: pointer;
  aspect-ratio: 3/2;
}
@media (min-width: 640px) { .gallery-cell { aspect-ratio: unset; } }

.gallery-cell:focus-visible { outline: 3px solid var(--clr-text); outline-offset: -3px; z-index: 1; }

.gallery-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.35s ease;
}
.gallery-cell:hover .gallery-img { transform: scale(1.04); }

.gallery-more-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  pointer-events: none;
}

/* Show all button */
.show-all-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--clr-text);
  background: var(--clr-bg);
  border: 1px solid var(--clr-border-light);
  border-radius: var(--radius-card);
  padding: 0.5rem 1rem;
  cursor: pointer;
  transition: box-shadow 0.15s ease, background 0.15s ease;
  margin-bottom: 0.5rem;
}
.show-all-btn:hover { box-shadow: var(--shadow-card); background: var(--clr-bg-subtle); }
.show-all-btn:focus-visible { outline: 2px solid var(--clr-text); outline-offset: 2px; }

/* ── Coming-soon sidebar ───────────────────────────────── */
.coming-soon-header { margin-bottom: 1.25rem; }

.coming-soon-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  background: #f0f4ff;
  color: #3b5bdb;
  border: 1px solid #c5d0f5;
  border-radius: 20px;
  padding: 0.3rem 0.75rem;
  margin-bottom: 0.875rem;
}

.coming-soon-headline {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--clr-text);
  margin-bottom: 0.5rem;
}

.coming-soon-sub {
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--clr-text-2);
}

.btn-notify-lg {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  font-size: 0.9rem;
  font-weight: 600;
  border-radius: var(--radius-btn, 8px);
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s ease, box-shadow 0.15s ease;
  background: #1a1a2e;
  color: #fff;
  border: none;
  box-shadow: 0 1px 4px rgba(0,0,0,0.18);
}
.btn-notify-lg:hover {
  background: #16213e;
  box-shadow: 0 4px 14px rgba(0,0,0,0.24);
}
.btn-notify-lg:focus-visible {
  outline: 2px solid var(--clr-text);
  outline-offset: 2px;
}

/* ── Detail grid ────────────────────────────────────────── */
.prop-detail-grid {
  display: grid;
  gap: 3rem;
  grid-template-columns: 1fr;
}
@media (min-width: 1024px) {
  .prop-detail-grid {
    grid-template-columns: 1fr 360px;
    align-items: start;
  }
}

.amenities-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  column-gap: 2rem;
}
@media (min-width: 640px) { .amenities-list { grid-template-columns: repeat(3, 1fr); } }

/* ── Lightbox ───────────────────────────────────────────── */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 9000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lightbox[hidden] { display: none; }

.lightbox-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.92);
}

.lightbox-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 3rem 1rem 1rem;
  box-sizing: border-box;
}

.lightbox-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(255,255,255,0.12);
  border: none;
  color: #fff;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
  z-index: 1;
}
.lightbox-close:hover { background: rgba(255,255,255,0.22); }
.lightbox-close:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

.lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.12);
  border: none;
  color: #fff;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
  z-index: 1;
}
.lightbox-prev { left: 0.75rem; }
.lightbox-next { right: 0.75rem; }
.lightbox-nav:hover { background: rgba(255,255,255,0.25); }
.lightbox-nav:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
.lightbox-nav:disabled { opacity: 0.25; cursor: default; }

@media (min-width: 640px) {
  .lightbox-prev { left: 1.5rem; }
  .lightbox-next { right: 1.5rem; }
}

.lightbox-img-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 1100px;
  min-height: 0;
}

.lightbox-img {
  max-width: 100%;
  max-height: calc(100vh - 180px);
  object-fit: contain;
  border-radius: 4px;
  display: block;
  transition: opacity 0.2s ease;
}

.lightbox-counter {
  color: rgba(255,255,255,0.6);
  font-size: 0.8rem;
  margin-top: 0.625rem;
  text-align: center;
}

.lightbox-thumbs {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 0.5rem 0;
  scrollbar-width: none;
  max-width: 100%;
}
.lightbox-thumbs::-webkit-scrollbar { display: none; }

.lightbox-thumb {
  flex-shrink: 0;
  width: 60px;
  height: 44px;
  object-fit: cover;
  border-radius: 3px;
  cursor: pointer;
  border: 2px solid transparent;
  opacity: 0.55;
  transition: opacity 0.15s, border-color 0.15s;
}
.lightbox-thumb.active,
.lightbox-thumb:hover { opacity: 1; border-color: #fff; }
</style>

<script is:inline define:vars={{ allImageSrcs: allImages.map(img => isLocal(img) ? img.src : img) }}>
(function () {
  const lightbox    = document.getElementById('lightbox');
  const lbImg       = document.getElementById('lightbox-img');
  const lbCounter   = document.getElementById('lightbox-counter');
  const lbThumbs    = document.getElementById('lightbox-thumbs');
  const lbPrev      = document.getElementById('lightbox-prev');
  const lbNext      = document.getElementById('lightbox-next');
  const lbClose     = document.getElementById('lightbox-close');
  const lbBackdrop  = document.getElementById('lightbox-backdrop');

  const srcs   = allImageSrcs;
  const total  = srcs.length;
  let current  = 0;

  // Build thumbnails
  srcs.forEach((src, i) => {
    const thumb = document.createElement('img');
    thumb.src     = src;
    thumb.alt     = '';
    thumb.className = 'lightbox-thumb';
    thumb.addEventListener('click', () => goTo(i));
    lbThumbs.appendChild(thumb);
  });

  function goTo(index) {
    current = (index + total) % total;
    lbImg.style.opacity = '0';
    setTimeout(() => {
      lbImg.src           = srcs[current];
      lbImg.alt           = `Photo ${current + 1} of ${total}`;
      lbCounter.textContent = `${current + 1} / ${total}`;
      lbImg.style.opacity = '1';
    }, 100);

    lbThumbs.querySelectorAll('.lightbox-thumb').forEach((t, i) => {
      t.classList.toggle('active', i === current);
    });

    // Scroll active thumb into view
    const activeTh = lbThumbs.querySelectorAll('.lightbox-thumb')[current];
    if (activeTh) activeTh.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

    lbPrev.disabled = false;
    lbNext.disabled = false;
  }

  function open(index) {
    current = index;
    goTo(index);
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function close() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
  }

  // Open from grid cells
  document.querySelectorAll('.gallery-cell').forEach(btn => {
    btn.addEventListener('click', () => open(Number(btn.dataset.index)));
  });

  // Open from "show all" button
  document.getElementById('show-all-btn')?.addEventListener('click', () => open(0));

  lbClose.addEventListener('click', close);
  lbBackdrop.addEventListener('click', close);
  lbPrev.addEventListener('click', () => goTo(current - 1));
  lbNext.addEventListener('click', () => goTo(current + 1));

  document.addEventListener('keydown', e => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });
})();
</script>
