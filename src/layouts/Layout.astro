---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { Font } from 'astro:assets';
import StickyActionBar from '../components/StickyActionBar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getAlternateLocale } from '../i18n/utils';
import { switcherPath, findRoute, normalisePath, ROUTES, type Locale, type RouteKey } from '../seo/routes';
import { baseGraph, type Crumb } from '../seo/schema';
import { OG } from '../seo/og';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Extra JSON-LD nodes (e.g. Apartment + Offer) merged into the page graph. */
  schema?: Record<string, unknown>[];
  /** Label for the final breadcrumb crumb. Defaults to the route's nav label. */
  breadcrumbName?: string;
  /** @id of the thing this page is primarily about. */
  schemaAbout?: string;
}

const {
  locale = 'en',
  title,
  description,
  ogImage,
  ogImageAlt,
  schema = [],
  breadcrumbName,
  schemaAbout,
} = Astro.props as Props;

const t = useTranslations(locale);
const navBase = locale === 'pt' ? '/pt' : '';
const altLocale = getAlternateLocale(locale as Locale);
// Falls back to the target locale's homepage when this page has no translation,
// so the switcher never points at a 404 (it did on /faq/ and /guide/).
const altPath = switcherPath(Astro.url.pathname, altLocale);
// BCP 47: "pt" alone can be read as Brazilian Portuguese. These pages are
// European Portuguese, and this must match the hreflang the SEO component emits.
const htmlLang = locale === 'pt' ? 'pt-PT' : 'en';

const resolvedTitle = title ?? t('site.default_title');
const resolvedDesc  = description ?? t('site.default_description');
const waBookNow = `https://wa.me/351911031847?text=${encodeURIComponent(t('hero.wa_message'))}`;

// ── Structured data ─────────────────────────────────────────────
// Every page carries the business, the website and a description of itself.
// Pages below the homepage also carry a breadcrumb trail.
const path = normalisePath(Astro.url.pathname);
const route = findRoute(path);
const routeKey = (route?.key ?? null) as RouteKey | null;
const localePrefix = locale === 'pt' ? 'pt' : 'en';
const routePath = (key: RouteKey) => ROUTES[key][localePrefix] ?? ROUTES[key].en;

const crumbLabels: Record<RouteKey, string> = {
  home: t('nav.home'),
  properties: t('nav.properties'),
  about: t('nav.about'),
  ramalho: t('footer.ramalho_link'),
  amorim: t('footer.amorim_link'),
  duplex: t('footer.duplex_link'),
  faq: 'FAQ',
  guide: 'Local guide',
};

const crumbs: Crumb[] = [{ name: t('nav.home'), path: routePath('home') }];
if (routeKey && routeKey !== 'home') {
  // Property pages sit under the properties listing.
  if (routeKey === 'ramalho' || routeKey === 'amorim' || routeKey === 'duplex') {
    crumbs.push({ name: t('nav.properties'), path: routePath('properties') });
  }
  crumbs.push({ name: breadcrumbName ?? crumbLabels[routeKey] });
}

// Social preview: falls back to the route's own image so no page can ship
// without one. Previously no page emitted og:image at all.
const og = routeKey ? OG[routeKey] : undefined;
const resolvedOgImage = ogImage ?? og?.image;
const resolvedOgAlt   = ogImageAlt ?? og?.alt[localePrefix];

const graph = [
  ...baseGraph({
    path,
    locale: localePrefix,
    routeKey,
    title: resolvedTitle,
    crumbs,
    about: schemaAbout,
  }),
  ...schema,
];
---

<!doctype html>
<html lang={htmlLang}>
<head>
  <SEO
    locale={locale as Locale}
    title={resolvedTitle}
    description={resolvedDesc}
    ogImage={resolvedOgImage}
    ogImageAlt={resolvedOgAlt}
    schema={graph}
  />
  <!-- Self-hosted Inter. Preloaded because body text cannot paint without it. -->
  <Font cssVariable="--font-inter" preload />
</head>
<body>

  <!-- ── Header ─────────────────────────────────────────── -->
  <header id="site-header" class="site-header">
    <div class="page-wrap header-inner">
      <!-- Logo -->
      <a href={`${navBase}/`} class="header-logo" aria-label={t('nav.logo_aria')}>
        Ramalho<span class="logo-dot">.</span><span class="logo-apartments">Apartments</span>
      </a>

      <!-- Desktop nav -->
      <nav class="header-nav" aria-label={t('nav.aria_label')}>
        <a href={`${navBase}/`}              class="nav-link">{t('nav.home')}</a>
        <a href={`${navBase}/properties/`}   class="nav-link">{t('nav.properties')}</a>
        <a href={`${navBase}/about/`}        class="nav-link">{t('nav.about')}</a>
      </nav>

      <!-- Desktop CTA + language switcher -->
      <div class="header-actions">
        <a href={altPath} class="lang-switcher" lang={altLocale} aria-label={altLocale === 'pt' ? 'Ver em Português' : 'View in English'}>
          {altLocale === 'pt' ? 'PT' : 'EN'}
        </a>
        <a href={waBookNow}
           target="_blank" rel="noopener noreferrer"
           class="btn btn-dark btn-sm">
          {t('nav.book_now')}
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button class="hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Mobile nav drawer -->
    <div id="mobile-nav" class="mobile-nav" aria-hidden="true" inert>
      <nav class="mobile-nav-links" aria-label={t('nav.aria_label')}>
        <a href={`${navBase}/`}              class="mobile-nav-link">{t('nav.home')}</a>
        <a href={`${navBase}/properties/`}   class="mobile-nav-link">{t('nav.properties')}</a>
        <a href={`${navBase}/about/`}        class="mobile-nav-link">{t('nav.about')}</a>
        <a href={altPath} class="mobile-nav-link lang-switcher-mobile" lang={altLocale}>
          {altLocale === 'pt' ? '🇵🇹 Português' : '🇬🇧 English'}
        </a>
        <a href={waBookNow}
           target="_blank" rel="noopener noreferrer"
           class="btn btn-dark" style="margin-top: 0.5rem; justify-content: center;">
          {t('nav.book_now')}
        </a>
      </nav>
    </div>
  </header>

  <!-- ── Page content ────────────────────────────────────── -->
  <main class="site-main" id="main-content">
    <slot />
  </main>

  <!-- ── Footer ──────────────────────────────────────────── -->
  <Footer {locale} />

  <!-- ── Mobile sticky CTA ───────────────────────────────── -->
  <StickyActionBar {locale} />

</body>
</html>

<style is:global>
/* ─── Header ──────────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--clr-border-light);
  transition: box-shadow 0.2s ease;
}
.site-header.scrolled { box-shadow: 0 1px 16px rgba(0,0,0,0.06); }

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  height: 64px;
}

.header-logo {
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--clr-text);
  flex-shrink: 0;
}
.logo-dot { color: #E31C5F; }
.logo-apartments { font-weight: 400; letter-spacing: 0; }

.header-nav {
  display: none;
  align-items: center;
  gap: 1.75rem;
}
@media (min-width: 768px) { .header-nav { display: flex; } }

.nav-link {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--clr-text-2);
  transition: color 0.15s ease;
}
.nav-link:hover, .nav-link.active { color: var(--clr-text); }

.header-actions { display: none; }
@media (min-width: 768px) { .header-actions { display: flex; align-items: center; gap: 0.75rem; } }

/* Language switcher */
.lang-switcher {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--clr-text-2);
  padding: 0.3rem 0.65rem;
  border: 1px solid var(--clr-border-light);
  border-radius: 20px;
  transition: color 0.15s, border-color 0.15s;
  text-decoration: none;
}
.lang-switcher:hover {
  color: var(--clr-text);
  border-color: var(--clr-border);
}

.lang-switcher-mobile {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--clr-text-2);
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--clr-border-light);
  text-decoration: none;
  border-radius: 0;
  border-left: none;
  border-right: none;
  border-top: none;
}

/* Hamburger */
.hamburger {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 0.5rem;
  background: none;
  border: none;
  cursor: pointer;
}
@media (min-width: 768px) { .hamburger { display: none; } }

.hamburger span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--clr-text);
  border-radius: 2px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* Mobile nav drawer */
.mobile-nav {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  border-top: 1px solid transparent;
}
.mobile-nav.open {
  max-height: 500px;
  border-top-color: var(--clr-border-light);
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 1rem var(--px-page) 1.25rem;
}
.mobile-nav-link {
  padding: 0.75rem 0;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--clr-text);
  border-bottom: 1px solid var(--clr-border-light);
}
.mobile-nav-link:last-of-type { border-bottom: none; }

/* Main content clears header + leaves room for mobile CTA */
.site-main { min-height: 60vh; padding-bottom: 5rem; }
@media (min-width: 768px) { .site-main { padding-bottom: 0; } }
</style>

<script>
// Scroll shadow
const header = document.getElementById('site-header');
window.addEventListener('scroll', () => {
  header?.classList.toggle('scrolled', window.scrollY > 8);
}, { passive: true });

// Hamburger toggle
const hamburger = document.getElementById('hamburger');
const mobileNav = document.getElementById('mobile-nav');
hamburger?.addEventListener('click', () => {
  const open = mobileNav?.classList.toggle('open');
  hamburger.setAttribute('aria-expanded', String(open));
  mobileNav?.setAttribute('aria-hidden', String(!open));
  // The drawer is hidden with max-height:0, not display:none, so without this
  // its links stay keyboard-focusable while invisible.
  if (open) mobileNav?.removeAttribute('inert');
  else mobileNav?.setAttribute('inert', '');
});

// Active nav link
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const here = norm(window.location.pathname);
const links = document.querySelectorAll('.nav-link, .mobile-nav-link');
links.forEach(link => {
  if (norm(new URL((link as HTMLAnchorElement).href).pathname) === here) {
    link.classList.add('active');
  }
});
</script>
