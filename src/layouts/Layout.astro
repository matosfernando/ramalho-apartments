---
import '../styles/global.css';
import StickyActionBar from '../components/StickyActionBar.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLocaleUrl, getAlternateLocale } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  locale?: string;
}

const {
  locale = 'en',
  title,
  description,
} = Astro.props as Props;

const t = useTranslations(locale);
const altLocale = getAlternateLocale(locale as 'en' | 'pt');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const currentPath = Astro.url.pathname;
const altPath = getLocaleUrl(currentPath, altLocale);
const canonicalUrl = `${siteUrl}${currentPath}`;
const alternateUrl = `${siteUrl}${altPath}`;

const resolvedTitle = title ?? t('site.default_title');
const resolvedDesc  = description ?? t('site.default_description');

const navBase = locale === 'pt' ? '/pt' : '';
const waBookNow = `https://wa.me/351911031847?text=${encodeURIComponent(t('hero.wa_message'))}`;
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="description" content={resolvedDesc} />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <title>{resolvedTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title"       content={resolvedTitle} />
  <meta property="og:description" content={resolvedDesc} />
  <meta property="og:type"        content="website" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en"      href={locale === 'en' ? canonicalUrl : alternateUrl} />
  <link rel="alternate" hreflang="pt"      href={locale === 'pt' ? canonicalUrl : alternateUrl} />
  <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonicalUrl : alternateUrl.replace('/pt', '') || '/'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>

  <!-- ── Header ─────────────────────────────────────────── -->
  <header id="site-header" class="site-header">
    <div class="page-wrap header-inner">
      <!-- Logo -->
      <a href={navBase || '/'} class="header-logo" aria-label={t('nav.logo_aria')}>
        Ramalho<span class="logo-dot">.</span><span class="logo-apartments">Apartments</span>
      </a>

      <!-- Desktop nav -->
      <nav class="header-nav" aria-label={t('nav.aria_label')}>
        <a href={navBase || '/'}             class="nav-link">{t('nav.home')}</a>
        <a href={`${navBase}/properties`}    class="nav-link">{t('nav.properties')}</a>
        <a href={`${navBase}/about`}         class="nav-link">{t('nav.about')}</a>
      </nav>

      <!-- Desktop CTA + language switcher -->
      <div class="header-actions">
        <a href={altPath} class="lang-switcher" lang={altLocale} aria-label={altLocale === 'pt' ? 'Ver em Português' : 'View in English'}>
          {altLocale === 'pt' ? 'PT' : 'EN'}
        </a>
        <a href={waBookNow}
           target="_blank" rel="noopener noreferrer"
           class="btn btn-dark btn-sm">
          {t('nav.book_now')}
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button class="hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>

    <!-- Mobile nav drawer -->
    <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
      <nav class="mobile-nav-links" aria-label={t('nav.aria_label')}>
        <a href={navBase || '/'}             class="mobile-nav-link">{t('nav.home')}</a>
        <a href={`${navBase}/properties`}    class="mobile-nav-link">{t('nav.properties')}</a>
        <a href={`${navBase}/about`}         class="mobile-nav-link">{t('nav.about')}</a>
        <a href={altPath} class="mobile-nav-link lang-switcher-mobile" lang={altLocale}>
          {altLocale === 'pt' ? '🇵🇹 Português' : '🇬🇧 English'}
        </a>
        <a href={waBookNow}
           target="_blank" rel="noopener noreferrer"
           class="btn btn-dark" style="margin-top: 0.5rem; justify-content: center;">
          {t('nav.book_now')}
        </a>
      </nav>
    </div>
  </header>

  <!-- ── Page content ────────────────────────────────────── -->
  <main class="site-main" id="main-content">
    <slot />
  </main>

  <!-- ── Footer ──────────────────────────────────────────── -->
  <Footer {locale} />

  <!-- ── Mobile sticky CTA ───────────────────────────────── -->
  <StickyActionBar {locale} />

</body>
</html>

<style is:global>
/* ─── Header ──────────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--clr-border-light);
  transition: box-shadow 0.2s ease;
}
.site-header.scrolled { box-shadow: 0 1px 16px rgba(0,0,0,0.06); }

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  height: 64px;
}

.header-logo {
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--clr-text);
  flex-shrink: 0;
}
.logo-dot { color: #E31C5F; }
.logo-apartments { font-weight: 400; letter-spacing: 0; }

.header-nav {
  display: none;
  align-items: center;
  gap: 1.75rem;
}
@media (min-width: 768px) { .header-nav { display: flex; } }

.nav-link {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--clr-text-2);
  transition: color 0.15s ease;
}
.nav-link:hover, .nav-link.active { color: var(--clr-text); }

.header-actions { display: none; }
@media (min-width: 768px) { .header-actions { display: flex; align-items: center; gap: 0.75rem; } }

/* Language switcher */
.lang-switcher {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--clr-text-2);
  padding: 0.3rem 0.65rem;
  border: 1px solid var(--clr-border-light);
  border-radius: 20px;
  transition: color 0.15s, border-color 0.15s;
  text-decoration: none;
}
.lang-switcher:hover {
  color: var(--clr-text);
  border-color: var(--clr-border);
}

.lang-switcher-mobile {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--clr-text-2);
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--clr-border-light);
  text-decoration: none;
  border-radius: 0;
  border-left: none;
  border-right: none;
  border-top: none;
}

/* Hamburger */
.hamburger {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 0.5rem;
  background: none;
  border: none;
  cursor: pointer;
}
@media (min-width: 768px) { .hamburger { display: none; } }

.hamburger span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--clr-text);
  border-radius: 2px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* Mobile nav drawer */
.mobile-nav {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  border-top: 1px solid transparent;
}
.mobile-nav.open {
  max-height: 500px;
  border-top-color: var(--clr-border-light);
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 1rem var(--px-page) 1.25rem;
}
.mobile-nav-link {
  padding: 0.75rem 0;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--clr-text);
  border-bottom: 1px solid var(--clr-border-light);
}
.mobile-nav-link:last-of-type { border-bottom: none; }

/* Main content clears header + leaves room for mobile CTA */
.site-main { min-height: 60vh; padding-bottom: 5rem; }
@media (min-width: 768px) { .site-main { padding-bottom: 0; } }
</style>

<script>
// Scroll shadow
const header = document.getElementById('site-header');
window.addEventListener('scroll', () => {
  header?.classList.toggle('scrolled', window.scrollY > 8);
}, { passive: true });

// Hamburger toggle
const hamburger = document.getElementById('hamburger');
const mobileNav = document.getElementById('mobile-nav');
hamburger?.addEventListener('click', () => {
  const open = mobileNav?.classList.toggle('open');
  hamburger.setAttribute('aria-expanded', String(open));
  mobileNav?.setAttribute('aria-hidden', String(!open));
});

// Active nav link
const links = document.querySelectorAll('.nav-link, .mobile-nav-link');
links.forEach(link => {
  if ((link as HTMLAnchorElement).href === window.location.href) {
    link.classList.add('active');
  }
});
</script>
