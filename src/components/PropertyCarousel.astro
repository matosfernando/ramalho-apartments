---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '../i18n/utils';

interface Property {
  title:        string;
  image:        ImageMetadata | string;
  /** Describes the photo. Must not repeat the title, which is visible right below it. */
  imageAlt?:    string;
  href:         string;
  price?:       string;
  rating?:      number;
  ratingSource?: string;
  ratingUrl?:   string;
  ratingScale?: number;   // 10 = Booking.com scale, else star scale
  openingDate?: string;   // "October 2026" — replaces rating row when set
  bedrooms?:    number;
  beds?:        number;
  baths?:       number;
}

interface Props {
  properties: Property[];
  title?: string;
  locale?: string;
}

const { properties, locale = 'en' } = Astro.props as Props;
const t = useTranslations(locale);
const title = Astro.props.title ?? t('carousel.title');
---

<section class="section" style="padding-top: 2.5rem;">
  <div class="page-wrap">

    <!-- Section header -->
    <div class="carousel-header">
      <h2 style="letter-spacing:-0.03em;">{title}</h2>
      <div class="carousel-arrows" aria-label="Carousel controls">
        <button class="carousel-prev btn btn-outline btn-sm" aria-label="Previous" style="padding:0.4rem 0.6rem; border-radius:50%;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="carousel-next btn btn-outline btn-sm" aria-label="Next" style="padding:0.4rem 0.6rem; border-radius:50%;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Cards track -->
    <div class="scroll-track cards-track" role="list">
      {properties.map((p, i) => (
        <article class="prop-card" role="listitem">

          <!-- Image -->
          <a href={p.href} class="prop-img prop-card-img" aria-label={`View ${p.title}`} tabindex="0">
            {typeof p.image === 'object' ? (
              <Image
                src={p.image as ImageMetadata}
                alt={p.imageAlt ?? p.title}
                loading={i < 3 ? "eager" : "lazy"}
                width={480}
                height={360}
              />
            ) : (
              <img
                src={p.image}
                alt={p.imageAlt ?? p.title}
                loading={i < 3 ? "eager" : "lazy"}
                width="480"
                height="360"
              />
            )}
            <!-- Wishlist -->
            <button
              type="button"
              class="wishlist-btn"
              aria-label={`Save ${p.title} to wishlist`}
              aria-pressed="false"
            >
              <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                <path
                  d="M16 28C15 27 3 19 3 11.5a7.5 7.5 0 0115 0 7.5 7.5 0 0115 0C33 19 21 27 16 28z"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  class="heart-path"
                />
              </svg>
            </button>
            <!-- Dot indicators -->
            <div class="card-dots" aria-hidden="true">
              <span class="card-dot active"></span>
              <span class="card-dot"></span>
              <span class="card-dot"></span>
            </div>
            <!-- Coming-soon badge -->
            {p.openingDate && (
              <span class="coming-soon-badge">{t('carousel.opening')} {p.openingDate}</span>
            )}
          </a>

          <!-- Info — div so the rating <a> is a valid standalone link -->
          <div class="prop-card-info">
            <a href={p.href} class="prop-name-link">
              <p class="prop-name">{p.title}</p>
            </a>

            {p.openingDate ? (
              <div class="prop-notify-row">
                <span class="opening-label">{t('carousel.opening')} {p.openingDate}</span>
                <a
                  href={`mailto:ramalhoapartments@gmail.com?subject=${encodeURIComponent("Notify me – " + p.title)}&body=${encodeURIComponent("Hi,\n\nPlease notify me when " + p.title + " opens for bookings.\n\nName:\nEmail:\n\nThanks!")}`}
                  class="btn btn-outline prop-notify-btn"
                  aria-label={`Get notified when ${p.title} opens`}
                >
                  <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                  </svg>
                  {t('carousel.get_notified')}
                </a>
              </div>
            ) : (
              <p class="prop-meta">
                {/* Price */}
                {p.price && (
                  <>
                    <span class="prop-price">{t('carousel.from')} {p.price}</span>
                    <span class="prop-meta-dim">&thinsp;{t('carousel.per_night')}</span>
                  </>
                )}

                {/* Separator */}
                {p.price && p.rating != null && (
                  <span class="prop-dot">&nbsp;·&nbsp;</span>
                )}

                {/* Booking.com 10-point score */}
                {p.rating != null && p.ratingScale === 10 ? (
                  <a
                    href={p.ratingUrl ?? '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rating-ext-link"
                    aria-label={`${p.rating.toFixed(1)} out of 10 on ${p.ratingSource} – opens in new tab`}
                  >
                    <span class="score-badge">{p.rating.toFixed(1)}</span>
                    <span class="rating-src">&thinsp;· {p.ratingSource}</span>
                  </a>

                /* Standard 5-point star rating */
                ) : p.rating != null ? (
                  <>
                    <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span class="rating-val">{p.rating.toFixed(1)}</span>
                    {p.ratingSource && <span class="rating-src">&thinsp;· {p.ratingSource}</span>}
                  </>
                ) : null}
              </p>
            )}

            {(p.bedrooms || p.beds || p.baths) && (
              <p class="prop-amenities">
                {[
                  p.bedrooms && `${p.bedrooms} bedroom${p.bedrooms !== 1 ? "s" : ""}`,
                  p.beds     && `${p.beds} bed${p.beds !== 1 ? "s" : ""}`,
                  p.baths    && `${p.baths} bath${p.baths !== 1 ? "s" : ""}`,
                ].filter(Boolean).join(" · ")}
              </p>
            )}
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
.carousel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.carousel-arrows { display: none; gap: 0.4rem; }
@media (min-width: 768px) { .carousel-arrows { display: flex; } }

.cards-track { display: flex; gap: 1.25rem; padding-bottom: 0.5rem; }
@media (min-width: 768px) { .cards-track { gap: 1.5rem; } }

.prop-card {
  flex-shrink: 0;
  width: min(72vw, 280px);
}
@media (min-width: 768px)  { .prop-card { width: calc(50% - 0.75rem); } }
@media (min-width: 1024px) { .prop-card { width: calc(33.333% - 1rem); } }
@media (min-width: 1280px) { .prop-card { width: calc(25% - 1.125rem); } }

/* Image link */
.prop-card-img {
  display: block;
  text-decoration: none;
  cursor: pointer;
  margin-bottom: 0.75rem;
  position: relative;
}
.prop-card-img:focus-visible { outline: 2px solid var(--clr-text); outline-offset: 3px; border-radius: var(--radius-card); }

/* Dot indicators */
.card-dots {
  position: absolute;
  bottom: 0.75rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
}
.card-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.55); }
.card-dot.active { background: #fff; width: 20px; border-radius: 3px; }

/* Coming-soon badge */
.coming-soon-badge {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  background: rgba(17,17,17,0.82);
  color: #fff;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  padding: 0.3rem 0.7rem;
  border-radius: 20px;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  pointer-events: none;
}

/* Info section */
.prop-card-info { padding: 0 0.125rem; }

.prop-name-link { display: block; text-decoration: none; color: inherit; margin-bottom: 0.2rem; }
.prop-name-link:hover .prop-name { text-decoration: underline; text-underline-offset: 2px; }
.prop-name { font-size: 0.88rem; font-weight: 600; color: var(--clr-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Meta row */
.prop-meta      { font-size: 0.82rem; color: var(--clr-text-2); display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 0.15rem; }
.prop-price     { font-weight: 600; color: var(--clr-text); }
.prop-meta-dim  { color: var(--clr-text-2); }
.prop-dot       { color: var(--clr-text-2); }
.prop-amenities { font-size: 0.8rem; color: var(--clr-text-2); }

/* Star rating */
.star-icon { width: 12px; height: 12px; color: var(--clr-text); flex-shrink: 0; }
.rating-val { font-weight: 500; color: var(--clr-text); }
.rating-src { color: var(--clr-text-2); }

/* External rating link (Booking.com etc.) */
.rating-ext-link {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  color: var(--clr-text-2);
}
.rating-ext-link:hover .rating-src { text-decoration: underline; text-underline-offset: 2px; }
.score-badge { font-weight: 700; color: var(--clr-text); font-size: 0.82rem; }

/* Opening date label */
.opening-label { font-size: 0.78rem; color: var(--clr-text-2); font-style: italic; }

/* Notify row */
.prop-notify-row {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 0.15rem;
}

.prop-notify-btn {
  padding: 0.35rem 0.85rem;
  font-size: 0.78rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Wishlist toggle
  document.querySelectorAll('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      const pressed = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!pressed));
      btn.classList.toggle('saved', !pressed);
    });
  });

  // Carousel arrows (per-section)
  document.querySelectorAll('.cards-track').forEach(track => {
    const section = track.closest('section');
    if (!section) return;
    const prev = section.querySelector('.carousel-prev') as HTMLButtonElement | null;
    const next = section.querySelector('.carousel-next') as HTMLButtonElement | null;

    const scrollAmount = () => {
      const card = track.querySelector('.prop-card') as HTMLElement | null;
      return card ? card.offsetWidth + 24 : 300;
    };

    const update = () => {
      if (prev) { prev.disabled = track.scrollLeft <= 1; prev.style.opacity = prev.disabled ? '0.35' : '1'; }
      if (next) { next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1; next.style.opacity = next.disabled ? '0.35' : '1'; }
    };

    prev?.addEventListener('click', () => track.scrollBy({ left: -scrollAmount() * 2, behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left:  scrollAmount() * 2, behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
});
</script>
