---
/**
 * PropertyCarousel Component
 * Horizontal scrollable carousel displaying properties Wander.com style
 */
interface Property {
  title: string;
  subtitle?: string;
  description: string;
  image: string;
  href: string;
  price: string;
  rating?: number;
  reviews?: number;
}

interface Props {
  properties: Property[];
  title?: string;
  subtitle?: string;
}

const { properties, title = "Homes our guests love", subtitle } = Astro.props as Props;
---

<section class="w-full py-16 md:py-20 bg-white">
  <div class="px-4 md:px-8 lg:px-12">
    <!-- Section Header -->
    <div class="mb-8 md:mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">{title}</h2>
      {subtitle && (
        <p class="text-base md:text-lg text-gray-600">{subtitle}</p>
      )}
    </div>

    <!-- Carousel Container -->
    <div class="relative group">
      <!-- Carousel Wrapper -->
      <div 
        class="carousel-wrapper overflow-x-auto scroll-smooth snap-x snap-mandatory"
        id="propertyCarousel"
      >
        <!-- Carousel Track -->
        <div class="flex gap-4 md:gap-6 pb-4 md:pb-0">
          {properties.map((property) => (
            <a 
              href={property.href}
              class="carousel-item flex-shrink-0 w-full sm:w-1/2 lg:w-1/3 snap-start scroll-ml-4 md:scroll-ml-8 lg:scroll-ml-12 group/card"
            >
              <!-- Card Container -->
              <div class="flex flex-col h-full">
                <!-- Image Container -->
                <div class="relative overflow-hidden rounded-2xl bg-gray-200 h-80 md:h-96 mb-4 flex-shrink-0">
                  <img 
                    src={property.image}
                    alt={property.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
                    loading="lazy"
                  />
                  
                  <!-- Wishlist Button -->
                  <button
                    type="button"
                    class="absolute top-3 right-3 z-10 w-10 h-10 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center hover:bg-white transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                    aria-label="Save to wishlist"
                  >
                    <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                  </button>

                  <!-- Rating Badge (Optional) -->
                  {property.rating && (
                    <div class="absolute bottom-3 left-3 bg-white/95 backdrop-blur-sm rounded-lg px-3 py-2 flex items-center gap-1">
                      <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      <span class="text-sm font-semibold text-gray-900">{property.rating.toFixed(1)}</span>
                      {property.reviews && (
                        <span class="text-xs text-gray-600">({property.reviews})</span>
                      )}
                    </div>
                  )}
                </div>

                <!-- Content -->
                <div class="flex-1 flex flex-col">
                  <!-- Location/Subtitle -->
                  {property.subtitle && (
                    <p class="text-sm text-gray-600 mb-1">{property.subtitle}</p>
                  )}
                  
                  <!-- Title -->
                  <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-2 group-hover/card:text-blue-600 transition-colors">
                    {property.title}
                  </h3>
                  
                  <!-- Description -->
                  <p class="text-sm md:text-base text-gray-600 mb-4 line-clamp-2 flex-1">
                    {property.description}
                  </p>

                  <!-- Price -->
                  <div class="pt-4 border-t border-gray-200">
                    <p class="text-sm text-gray-600">
                      <span class="text-lg md:text-xl font-bold text-gray-900">{property.price}</span>
                      <span class="text-gray-600"> per night</span>
                    </p>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation Buttons (Desktop Only) -->
      <button
        class="carousel-nav-btn carousel-prev hidden lg:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-20 w-12 h-12 rounded-full bg-white border-2 border-gray-200 shadow-lg hover:shadow-xl hover:border-gray-400 transition-all items-center justify-center group-hover:opacity-100"
        aria-label="Previous properties"
      >
        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        class="carousel-nav-btn carousel-next hidden lg:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-20 w-12 h-12 rounded-full bg-white border-2 border-gray-200 shadow-lg hover:shadow-xl hover:border-gray-400 transition-all items-center justify-center group-hover:opacity-100"
        aria-label="Next properties"
      >
        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Mobile Scroll Indicator -->
      <div class="lg:hidden mt-4 flex justify-center gap-1">
        {properties.map((_, index) => (
          <div 
            key={index}
            class="carousel-dot h-2 w-2 rounded-full bg-gray-300 transition-all"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const carousels = document.querySelectorAll('.carousel-wrapper');
  
  carousels.forEach((carousel) => {
    const prevBtn = carousel.closest('.relative')?.querySelector('.carousel-prev');
    const nextBtn = carousel.closest('.relative')?.querySelector('.carousel-next');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -400, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: 400, behavior: 'smooth' });
      });
    }

    // Update dots on scroll
    carousel.addEventListener('scroll', () => {
      const wrapper = carousel.closest('.relative');
      if (!wrapper) return;
      
      const dots = wrapper.querySelectorAll('.carousel-dot');
      const scrollPosition = carousel.scrollLeft;
      const itemWidth = carousel.querySelector('.carousel-item')?.offsetWidth || 0;
      const visibleItemIndex = Math.round(scrollPosition / itemWidth);
      
      dots.forEach((dot, index) => {
        dot.classList.toggle('bg-gray-900', index === visibleItemIndex);
        dot.classList.toggle('bg-gray-300', index !== visibleItemIndex);
      });
    });
  });
});
</script>

<style>
.carousel-wrapper {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE and Edge */
}

.carousel-wrapper::-webkit-scrollbar {
  display: none; /* Chrome, Safari and Opera */
}

@media (max-width: 768px) {
  .carousel-item {
    scroll-snap-align: start;
    scroll-padding-left: 1rem;
  }
}
</style>
