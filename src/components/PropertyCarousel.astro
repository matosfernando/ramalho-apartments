---
interface Property {
  title: string;
  subtitle?: string;
  image: string;
  href: string;
  price: string;
  nights?: number;
  rating?: number;
  isNew?: boolean;
  bedrooms?: number;
  beds?: number;
  baths?: number;
}

interface Props {
  properties: Property[];
  title?: string;
}

const { properties, title = "Homes our guests love" } = Astro.props as Props;
---

<section class="section" style="padding-top: 2.5rem;">
  <div class="page-wrap">

    <!-- Section header -->
    <div class="carousel-header">
      <h2 style="letter-spacing:-0.03em;">{title}</h2>
      <div class="carousel-arrows" aria-label="Carousel controls">
        <button class="carousel-prev btn btn-outline btn-sm" aria-label="Previous" style="padding:0.4rem 0.6rem; border-radius:50%;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="carousel-next btn btn-outline btn-sm" aria-label="Next" style="padding:0.4rem 0.6rem; border-radius:50%;">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Cards track -->
    <div class="scroll-track cards-track" role="list">
      {properties.map((p, i) => (
        <article class="prop-card" role="listitem">
          <!-- Image -->
          <a href={p.href} class="prop-img prop-card-img" aria-label={`View ${p.title}`} tabindex="0">
            <img
              src={p.image}
              alt={p.title}
              loading={i < 3 ? "eager" : "lazy"}
              width="480"
              height="360"
            />
            <!-- Wishlist -->
            <button
              type="button"
              class="wishlist-btn"
              aria-label={`Save ${p.title} to wishlist`}
              aria-pressed="false"
            >
              <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
                <path
                  d="M16 28C15 27 3 19 3 11.5a7.5 7.5 0 0115 0 7.5 7.5 0 0115 0C33 19 21 27 16 28z"
                  fill="none"
                  stroke="white"
                  stroke-width="2"
                  class="heart-path"
                />
              </svg>
            </button>
            <!-- Dot indicators -->
            <div class="card-dots" aria-hidden="true">
              <span class="card-dot active"></span>
              <span class="card-dot"></span>
              <span class="card-dot"></span>
            </div>
          </a>

          <!-- Info -->
          <a href={p.href} class="prop-card-info">
            {p.subtitle && <p class="prop-location">{p.subtitle}</p>}
            <p class="prop-name">{p.title}</p>
            <p class="prop-meta">
              <span class="prop-price">{p.price}</span>
              {p.nights && <span class="prop-meta-dim"> for {p.nights} nights</span>}
              {p.rating != null && (
                <>
                  <span class="prop-dot">·</span>
                  <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="color:#222;">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <span style="font-weight:500; color:var(--clr-text);">{p.isNew ? " New" : ` ${p.rating.toFixed(1)}`}</span>
                </>
              )}
            </p>
            {(p.bedrooms || p.beds || p.baths) && (
              <p class="prop-amenities">
                {[
                  p.bedrooms && `${p.bedrooms} bedroom${p.bedrooms !== 1 ? "s" : ""}`,
                  p.beds     && `${p.beds} bed${p.beds !== 1 ? "s" : ""}`,
                  p.baths    && `${p.baths} bath${p.baths !== 1 ? "s" : ""}`,
                ].filter(Boolean).join(" · ")}
              </p>
            )}
          </a>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
.carousel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.carousel-arrows {
  display: none;
  gap: 0.4rem;
}
@media (min-width: 768px) { .carousel-arrows { display: flex; } }

.cards-track {
  display: flex;
  gap: 1.25rem;
  padding-bottom: 0.5rem;
}
@media (min-width: 768px) {
  .cards-track { gap: 1.5rem; }
}

.prop-card {
  flex-shrink: 0;
  width: min(72vw, 280px);
}
@media (min-width: 768px)  { .prop-card { width: calc(50% - 0.75rem); } }
@media (min-width: 1024px) { .prop-card { width: calc(33.333% - 1rem); } }
@media (min-width: 1280px) { .prop-card { width: calc(25% - 1.125rem); } }

.prop-card-img {
  display: block;
  text-decoration: none;
  cursor: pointer;
  margin-bottom: 0.75rem;
}
.prop-card-img:focus-visible { outline: 2px solid var(--clr-text); outline-offset: 3px; border-radius: var(--radius-card); }

/* Dots */
.card-dots {
  position: absolute;
  bottom: 0.75rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4px;
}
.card-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: rgba(255,255,255,0.55);
}
.card-dot.active { background: #fff; width: 20px; border-radius: 3px; }

/* Info below image */
.prop-card-info {
  display: block;
  text-decoration: none;
  padding: 0 0.125rem;
}
.prop-location  { font-size: 0.78rem; color: var(--clr-text-2); margin-bottom: 0.2rem; }
.prop-name      { font-size: 0.88rem; font-weight: 600; color: var(--clr-text); margin-bottom: 0.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.prop-meta      { font-size: 0.82rem; color: var(--clr-text-2); display: flex; align-items: center; gap: 0.2rem; flex-wrap: wrap; margin-bottom: 0.15rem; }
.prop-price     { font-weight: 600; color: var(--clr-text); }
.prop-meta-dim  { color: var(--clr-text-2); }
.prop-dot       { color: var(--clr-text-3); }
.prop-amenities { font-size: 0.8rem; color: var(--clr-text-2); }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Wishlist toggle
  document.querySelectorAll('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      const pressed = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!pressed));
      btn.classList.toggle('saved', !pressed);
    });
  });

  // Carousel arrows (per-section)
  document.querySelectorAll('.cards-track').forEach(track => {
    const section = track.closest('section');
    if (!section) return;
    const prev = section.querySelector('.carousel-prev') as HTMLButtonElement | null;
    const next = section.querySelector('.carousel-next') as HTMLButtonElement | null;

    const scrollAmount = () => {
      const card = track.querySelector('.prop-card') as HTMLElement | null;
      return card ? card.offsetWidth + 24 : 300;
    };

    const update = () => {
      if (prev) { prev.disabled = track.scrollLeft <= 1; prev.style.opacity = prev.disabled ? '0.35' : '1'; }
      if (next) { next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1; next.style.opacity = next.disabled ? '0.35' : '1'; }
    };

    prev?.addEventListener('click', () => track.scrollBy({ left: -scrollAmount() * 2, behavior: 'smooth' }));
    next?.addEventListener('click', () => track.scrollBy({ left:  scrollAmount() * 2, behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    update();
  });
});
</script>
