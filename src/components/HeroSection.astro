---
interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  height?: string;
}

const {
  title,
  subtitle,
  backgroundImage = "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1920&h=1080&fit=crop",
  height = "68vh",
} = Astro.props as Props;
---

<section class="hero" style={`min-height: ${height};`}>
  <div
    class="hero-bg"
    style={`background-image: url('${backgroundImage}')`}
    role="img"
    aria-hidden="true"
  />
  <div class="hero-overlay" />
  <div class="hero-content page-wrap">
    <h1 style="color:#fff; max-width: 640px; text-shadow: 0 2px 20px rgba(0,0,0,0.2);">
      {title}
    </h1>
    {subtitle && (
      <p style="color: rgba(255,255,255,0.85); margin-top:0.75rem; font-size:1rem; max-width:480px; line-height:1.6;">
        {subtitle}
      </p>
    )}
  </div>
</section>
