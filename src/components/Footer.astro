---
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props as Props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const base = locale === 'pt' ? '/pt' : '';
---

<footer class="site-footer">
  <div class="page-wrap">
    <div class="footer-grid">

      <!-- Brand -->
      <div>
        <p style="font-size:1.05rem; font-weight:700; letter-spacing:-0.03em; color: var(--clr-text); margin-bottom:0.75rem;">
          Ramalho<span style="color:#E31C5F;">.</span><span style="font-weight:400; letter-spacing:0;">Apartments</span>
        </p>
        <p style="font-size:0.85rem; max-width:260px; line-height:1.6;">
          {t('footer.tagline')}
        </p>
        <div style="display:flex; gap:0.6rem; margin-top:1.25rem;">
          <a href="https://www.facebook.com/RamalhoApartments" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <!-- Properties -->
      <div>
        <p class="footer-heading">{t('footer.properties')}</p>
        <a href={`${base}/ramalho/`}       class="footer-link">{t('footer.ramalho_link')}</a>
        <a href={`${base}/amorim/`}        class="footer-link">{t('footer.amorim_link')}</a>
        <a href={`${base}/amorim-duplex/`} class="footer-link">{t('footer.duplex_link')}</a>
      </div>

      <!-- Explore -->
      <div>
        <p class="footer-heading">{t('footer.explore')}</p>
        <a href={`${base}/about/`} class="footer-link">{t('footer.about_link')}</a>
      </div>

      <!-- Contact -->
      <div>
        <p class="footer-heading">{t('footer.contact')}</p>
        <a href="https://wa.me/351911031847" target="_blank" rel="noopener noreferrer" class="footer-link">WhatsApp</a>
        <a href="mailto:ramalhoapartments@gmail.com" class="footer-link">ramalhoapartments@gmail.com</a>
        <span class="footer-link" style="cursor:default;">+351 911 031 847</span>
        <span class="footer-link" style="cursor:default;">Ponta Delgada, Azores</span>
      </div>

    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Ramalho Apartments. {t('footer.copyright')}</span>
      <span>Ponta Delgada, Azores, Portugal</span>
    </div>
  </div>
</footer>
