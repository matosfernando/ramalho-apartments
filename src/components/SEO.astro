---
/**
 * Every page's <head> metadata, in one place.
 *
 * Renders only inside <head> — it emits no visible markup and cannot affect
 * layout. Previously this block was inline in Layout.astro and was missing
 * og:image, og:url, og:site_name, og:locale, the whole Twitter card, the robots
 * directive and JSON-LD; and its hreflang was unconditional (see src/seo/routes.ts).
 */
import { SITE_URL, BUSINESS } from '../seo/business';
import { alternatesFor, normalisePath, type Locale } from '../seo/routes';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Absolute path under /og/, e.g. "/og/ramalho-en.jpg". Omitted if absent. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD nodes for this page, merged into one @graph. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  schema = [],
  noindex = false,
} = Astro.props as Props;

const path = normalisePath(Astro.url.pathname);
const abs = (p: string) => `${SITE_URL}${p}`;

const canonical = abs(path);
const alternates = alternatesFor(path);

const ogLocale = locale === 'pt' ? 'pt_PT' : 'en_GB';
const ogLocaleAlt = locale === 'pt' ? 'en_GB' : 'pt_PT';
const hasAlternate = alternates.length > 0;

const ogImageUrl = ogImage ? abs(ogImage) : undefined;

const robots = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';

const graph =
  schema.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })
    : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#ffffff" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />

<link rel="canonical" href={canonical} />
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={abs(a.path)} />
))}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={BUSINESS.name} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogLocale} />
{hasAlternate && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
{ogImageUrl && (
  <>
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

{/* .ico first, then the SVG: browsers that understand SVG take it, the rest fall
    back. Both are the same "R." mark now — favicon.ico used to be the Astro
    framework's logo, and Chrome prefers the .ico, so that is what tabs showed. */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

{graph && <script type="application/ld+json" set:html={graph} />}
